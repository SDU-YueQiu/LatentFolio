<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:LatentFolio.App.Controls"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- 转换器放在这里而不是 MainWindow.Resources：
         UserControl 自己的资源作用域看不到 Window.Resources，会报「无法找到名为 B2V 的资源」。 -->
    <c:BoolToVis x:Key="B2V" />
    <c:BoolToVis x:Key="InvB2V" Invert="True" />
    <c:NotEmptyToVis x:Key="NE2V" />
    <c:IntToVis x:Key="I2V" />
    <c:Num x:Key="Num" />
    <c:DoubleToGridLength x:Key="D2G" />
    <c:HexToBrush x:Key="HexB" />
    <c:FilmWidth x:Key="FilmW" />

    <!-- ================================================================
         设计语言「Quiet Studio」
         · 中性冷灰打底，界面本体全是留白，让图片当主角
         · 一个虹蓝主色（#4B5CF5），只出现在选中、焦点、进度上，不做装饰
         · 半径：控件 8 / 行 9 / 卡片 12 / 胶囊 999
         · 阴影只给浮层和卡片，列表项一律靠描边和底色分层（性能）
         ================================================================ -->

    <!-- ================= 颜色 ================= -->
    <Color x:Key="C.Window">#FFFFFFFF</Color>
    <Color x:Key="C.Canvas">#FFF7F8FB</Color>
    <Color x:Key="C.Panel">#FFFBFCFD</Color>
    <Color x:Key="C.Tile">#FFF1F3F8</Color>
    <Color x:Key="C.Inset">#FFF1F3F8</Color>
    <Color x:Key="C.Hover">#FFF2F4F9</Color>
    <Color x:Key="C.Pressed">#FFE9ECF3</Color>
    <Color x:Key="C.Sel">#FFEDEFFE</Color>
    <Color x:Key="C.Hairline">#FFF1F2F6</Color>
    <Color x:Key="C.Border">#FFE7E9F0</Color>
    <Color x:Key="C.BorderStrong">#FFD6DAE4</Color>
    <Color x:Key="C.Text">#FF101319</Color>
    <Color x:Key="C.Text2">#FF5B6373</Color>
    <Color x:Key="C.Text3">#FF98A0AF</Color>
    <Color x:Key="C.Accent">#FF4B5CF5</Color>
    <Color x:Key="C.AccentDark">#FF3A48D8</Color>
    <Color x:Key="C.AccentSoft">#FFEEEFFE</Color>
    <Color x:Key="C.AccentSoft2">#FFE2E5FD</Color>
    <Color x:Key="C.Star">#FFF5A524</Color>
    <Color x:Key="C.Danger">#FFE5484D</Color>
    <Color x:Key="C.DangerSoft">#FFFEECEC</Color>
    <Color x:Key="C.Ok">#FF12A594</Color>
    <Color x:Key="C.Warn">#FFF5A524</Color>

    <SolidColorBrush x:Key="B.Window" Color="{StaticResource C.Window}" />
    <SolidColorBrush x:Key="B.Canvas" Color="{StaticResource C.Canvas}" />
    <SolidColorBrush x:Key="B.Panel" Color="{StaticResource C.Panel}" />
    <SolidColorBrush x:Key="B.Tile" Color="{StaticResource C.Tile}" />
    <SolidColorBrush x:Key="B.Inset" Color="{StaticResource C.Inset}" />
    <SolidColorBrush x:Key="B.Hover" Color="{StaticResource C.Hover}" />
    <SolidColorBrush x:Key="B.Pressed" Color="{StaticResource C.Pressed}" />
    <SolidColorBrush x:Key="B.Sel" Color="{StaticResource C.Sel}" />
    <SolidColorBrush x:Key="B.Hairline" Color="{StaticResource C.Hairline}" />
    <SolidColorBrush x:Key="B.Border" Color="{StaticResource C.Border}" />
    <SolidColorBrush x:Key="B.BorderStrong" Color="{StaticResource C.BorderStrong}" />
    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="B.Text2" Color="{StaticResource C.Text2}" />
    <SolidColorBrush x:Key="B.Text3" Color="{StaticResource C.Text3}" />
    <SolidColorBrush x:Key="B.Accent" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="B.AccentDark" Color="{StaticResource C.AccentDark}" />
    <SolidColorBrush x:Key="B.AccentSoft" Color="{StaticResource C.AccentSoft}" />
    <SolidColorBrush x:Key="B.AccentSoft2" Color="{StaticResource C.AccentSoft2}" />
    <SolidColorBrush x:Key="B.Star" Color="{StaticResource C.Star}" />
    <SolidColorBrush x:Key="B.Danger" Color="{StaticResource C.Danger}" />
    <SolidColorBrush x:Key="B.DangerSoft" Color="{StaticResource C.DangerSoft}" />
    <SolidColorBrush x:Key="B.Ok" Color="{StaticResource C.Ok}" />
    <SolidColorBrush x:Key="B.Warn" Color="{StaticResource C.Warn}" />
    <!-- 窗口最外层那一圈描边 -->
    <SolidColorBrush x:Key="B.Outline" Color="#FFCDD1DC" />
    <!-- 品牌标：从左到右由虹蓝过渡到紫，只用在顶部 logo 上 -->
    <LinearGradientBrush x:Key="B.Logo" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF5B6CFF" Offset="0" />
        <GradientStop Color="#FF8B5CF6" Offset="1" />
    </LinearGradientBrush>
    <!-- 查看器舞台：极浅的冷灰，让图片像浮在画布上 -->
    <LinearGradientBrush x:Key="B.Stage" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF6F7FA" Offset="0" />
        <GradientStop Color="#FFEDEFF5" Offset="1" />
    </LinearGradientBrush>
    <!-- 浮在图片上的工具条/滚轮 -->
    <SolidColorBrush x:Key="B.Glass" Color="#F5FFFFFF" />
    <SolidColorBrush x:Key="B.GlassDark" Color="#B31A1E27" />

    <FontFamily x:Key="F.UI">Microsoft YaHei UI, Segoe UI, Microsoft Sans Serif</FontFamily>
    <FontFamily x:Key="F.Num">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="F.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="F.Icon">Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="S.Radius">8</sys:Double>

    <!-- 阴影：只用在浮层、卡片、舞台上的大图；列表项绝不加 -->
    <DropShadowEffect x:Key="Fx.Card" BlurRadius="20" ShadowDepth="2" Direction="270"
                      Opacity="0.07" Color="#FF0B1220" />
    <DropShadowEffect x:Key="Fx.Pop" BlurRadius="28" ShadowDepth="6" Direction="270"
                      Opacity="0.14" Color="#FF0B1220" />
    <DropShadowEffect x:Key="Fx.Image" BlurRadius="34" ShadowDepth="8" Direction="270"
                      Opacity="0.16" Color="#FF0B1220" />

    <!-- ================= 文字 ================= -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 页面大标题 -->
    <Style x:Key="T.Page" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="T.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="T.CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="T.Sub" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="T.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- 栏标题：小号、字重半粗、字距略松，取代原来的大号黑体 -->
    <Style x:Key="T.Section" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- 数值（右对齐的计数、参数值） -->
    <Style x:Key="T.Value" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- 指标大数字 -->
    <Style x:Key="T.Num" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Num}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="T.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- 空状态：一行小字，居中，不加插画 -->
    <Style x:Key="T.Empty" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- ================= 滚动条 ================= -->
    <Style x:Key="SB.Thumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="b" Background="#FFC7CCD8" CornerRadius="4" Margin="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FFA7AEBE" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF8E96A8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="9" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SB.Thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="9" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource SB.Thumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                                    </Track.DecreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= 按钮 ================= -->
    <Style x:Key="Btn.Base" TargetType="ButtonBase">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                          RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 方形图标按钮：顶栏、卡片右上角的小动作都用它 -->
    <Style x:Key="Btn.Icon" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
    </Style>

    <Style x:Key="Btn.IconSm" TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>

    <!-- 窗口标题栏按钮（最小化/最大化/关闭） -->
    <Style x:Key="Btn.Win" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
    </Style>

    <Style x:Key="Btn.Primary" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource B.Accent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.AccentDark}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FF2F3BB8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Outline" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="White" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Hover}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.BorderStrong}" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 胶囊按钮：筛选、次级动作 -->
    <Style x:Key="Btn.Pill" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="White" BorderBrush="{StaticResource B.Border}"
                            BorderThickness="1" CornerRadius="999" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Hover}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 已生效的条件钉（筛选条上那几个） -->
    <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource B.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{StaticResource B.AccentSoft}" BorderBrush="Transparent"
                            BorderThickness="1" CornerRadius="999" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.AccentSoft2}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分段控件里的一个选项（选中态由代码设 Background/Foreground，和原来 StatsBuilder 的写法兼容） -->
    <Style x:Key="Btn.Seg" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分段控件的底槽 -->
    <Style x:Key="Seg.Track" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Inset}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="3" />
    </Style>

    <!-- ================= 输入框 ================= -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <!-- 不要再设 MinHeight：外面用 Height 限制的输入框会被顶大，然后上下各切掉一截 -->
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{StaticResource B.Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource B.AccentSoft2}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" SnapsToDevicePixels="True">
                        <!-- Margin 用 Padding 顶替、内容宿主垂直居中：
                             之前给宿主套 Padding 当 Margin，单行文字会被挤得只露上半截 -->
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="bd" Property="Background" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 勾选框 / 单选 ================= -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="box" Width="16" Height="16" CornerRadius="5" BorderThickness="1"
                                BorderBrush="{StaticResource B.BorderStrong}" Background="White"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="tick" Text="&#xE73E;" FontFamily="{StaticResource F.Icon}" FontSize="9"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse x:Name="ring" Stroke="{StaticResource B.BorderStrong}" StrokeThickness="1" Fill="White" />
                            <Ellipse x:Name="dot" Width="7" Height="7" Fill="{StaticResource B.Accent}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ring" Property="Stroke" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 下拉框 ================= -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="White" BorderBrush="{StaticResource B.Border}"
                            BorderThickness="1" CornerRadius="8">
                        <TextBlock x:Name="chev" Text="&#xE70D;" FontFamily="{StaticResource F.Icon}" FontSize="9"
                                   Foreground="{StaticResource B.Text3}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.BorderStrong}" />
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="chev" Property="Foreground" Value="{StaticResource B.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="PART_Toggle" Style="{StaticResource ComboToggle}"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter x:Name="PART_Content" Margin="10,0,26,0" VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               Focusable="False" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="White" BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                                    CornerRadius="10" Padding="4" Margin="0,5,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    Effect="{StaticResource Fx.Pop}">
                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.AccentSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource B.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 滑块（左半段填充主色） ================= -->
    <Style x:Key="Slider.Fill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" CornerRadius="2" Background="{StaticResource B.Accent}"
                            VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Slider.Rest" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" CornerRadius="2" Background="{StaticResource B.Inset}"
                            VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Height="20" Background="Transparent">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Slider.Fill}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="15" Height="15" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse Fill="White" />
                                                <Ellipse Stroke="{StaticResource B.Accent}" StrokeThickness="2" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Slider.Rest}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 边栏折叠手柄（贴在栏的内边缘，垂直居中） ================= -->
    <Style x:Key="Btn.Tab" TargetType="Button">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="88" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="White" CornerRadius="11" BorderThickness="1"
                            BorderBrush="{StaticResource B.Border}" Effect="{StaticResource Fx.Card}">
                        <!-- 手柄内容用半角尖括号 ‹ ›（U+2039/203A）：MDL2 里没有这两个码位，
                             换成 E76B 之类会渲染成空方框，所以这边也不锁图标字体 -->
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 分隔线 ================= -->
    <Style x:Key="VLine" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{StaticResource B.Border}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="HLine" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource B.Hairline}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ================= 单行列表项（左栏 / 各页列表） ================= -->
    <Style x:Key="RowItem" TargetType="ListBoxItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <!-- 选中：淡底色 + 左侧一条主色细杆，文字颜色不动（避免每行都要改绑定） -->
                        <Border x:Name="bar" Width="3" Height="14" CornerRadius="2" Margin="-5,0,0,0"
                                Background="{StaticResource B.Accent}" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Visibility="Collapsed" />
                        <Border x:Name="bd" Background="Transparent" CornerRadius="9" Margin="0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.AccentSoft}" />
                            <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <!-- ================= 卡片 / 胶囊 / 空状态 ================= -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style x:Key="Card.Flat" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource B.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Hairline}" />
    </Style>

    <Style x:Key="Card.Inset" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Inset}" />
        <Setter Property="CornerRadius" Value="9" />
    </Style>

    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Inset}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Pill.Accent" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{StaticResource B.AccentSoft}" />
    </Style>

    <Style x:Key="Pill.Danger" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{StaticResource B.DangerSoft}" />
    </Style>

    <!-- ================= 右键菜单 ================= -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}"
                            Effect="{StaticResource Fx.Pop}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- 勾选标记：勾了就把底色和勾一起显示 -->
                            <TextBlock x:Name="check" Grid.Column="0" Text="&#xE73E;" FontFamily="{StaticResource F.Icon}"
                                       FontSize="10" Margin="0,0,7,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource B.Accent}"
                                       Visibility="Collapsed" />
                            <ContentPresenter Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center"
                                              Margin="0,0,8,0" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       Foreground="{StaticResource B.Text3}" Margin="20,0,0,0" />
                            <TextBlock x:Name="arrow" Grid.Column="3" Text="&#xE76C;" FontFamily="{StaticResource F.Icon}"
                                       FontSize="9" Margin="14,0,0,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource B.Text3}"
                                       Visibility="Collapsed" />
                            <!-- 子菜单：之前这个 Popup 是空的，二级菜单根本弹不出内容 -->
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Right"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}" Focusable="False"
                                   HorizontalOffset="2" VerticalOffset="-6">
                                <Border Background="White" BorderBrush="{StaticResource B.Border}"
                                        BorderThickness="1" CornerRadius="11" Padding="5" Margin="0,0,4,0"
                                        Effect="{StaticResource Fx.Pop}">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{StaticResource B.Hairline}" Margin="6,5" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 提示气泡 ================= -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="#FF1B2029" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
