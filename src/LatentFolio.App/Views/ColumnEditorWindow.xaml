<Window x:Class="LatentFolio.App.Views.ColumnEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义栏" Height="720" Width="760"
        WindowStartupLocation="CenterOwner" Background="{StaticResource B.Window}"
        FontFamily="{StaticResource F.UI}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="新建自定义栏" x:Name="HeaderText" Style="{StaticResource T.Title}" />

        <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="名称" Style="{StaticResource T.Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox Grid.Column="1" x:Name="NameBox" Height="34" FontSize="13" />
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="10"
                Background="{StaticResource B.Panel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                <StackPanel x:Name="TreeHost" />
            </ScrollViewer>
        </Border>

        <Border Grid.Row="3" Margin="0,12,0,0" Background="{StaticResource B.Panel}" CornerRadius="8"
                BorderBrush="{StaticResource B.Border}" BorderThickness="1" Padding="12,10">
            <StackPanel>
                <TextBlock x:Name="ExprText" TextWrapping="Wrap" FontSize="11.5"
                           Foreground="{StaticResource B.Text2}" />
                <TextBlock x:Name="PreviewText" Margin="0,6,0,0" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource B.Accent}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Style="{StaticResource Btn.Outline}" Width="88" Height="34"
                    Click="OnCancel" Margin="0,0,10,0" />
            <Button Content="保存" Style="{StaticResource Btn.Primary}" Width="96" Height="34" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
