<Window x:Class="LatentFolio.App.Views.TagsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="标签体系" Height="760" Width="1080" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource B.Window}"
        FontFamily="{StaticResource F.UI}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="标签" Style="{StaticResource T.Title}" VerticalAlignment="Center" />
            <TextBox x:Name="FilterBox" Grid.Column="1" Width="240" Height="32" Margin="16,0,0,0"
                     HorizontalAlignment="Left" VerticalContentAlignment="Center" FontSize="12.5"
                     TextChanged="OnFilter" AutomationProperties.Name="搜索标签" />
            <TextBlock x:Name="CountText" Grid.Column="2" Style="{StaticResource T.Sub}"
                       VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="286" />
            </Grid.ColumnDefinitions>

            <!-- 分类 -->
            <Border Grid.Column="0" BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                    CornerRadius="10" Background="{StaticResource B.Panel}" Padding="6">
                <ListBox x:Name="CatList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource RowItem}"
                         SelectionChanged="OnCategoryChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid AutomationProperties.Name="{Binding Name}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource T.Sub}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 列表 -->
            <Border Grid.Column="2" BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                    CornerRadius="10" Background="{StaticResource B.Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 表头 -->
                    <Grid Grid.Row="0" Margin="12,10,12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.1*" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="标签" Style="{StaticResource T.Label}" />
                        <TextBlock Grid.Column="1" Text="类型" Style="{StaticResource T.Label}" />
                        <TextBlock Grid.Column="2" Text="命中" Style="{StaticResource T.Label}" />
                        <TextBlock Grid.Column="3" Text="来源" Style="{StaticResource T.Label}" />
                    </Grid>
                    <Border Grid.Row="0" Style="{StaticResource HLine}" Margin="12,34,12,0" />

                    <ListBox x:Name="RowList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             Margin="4,4,4,4" ItemContainerStyle="{StaticResource RowItem}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             SelectionMode="Extended"
                             SelectionChanged="OnRowSelected"
                             MouseDoubleClick="OnRowDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1" AutomationProperties.Name="{Binding Key}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.1*" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Sub}" FontSize="10.5"
                                                   Foreground="{StaticResource B.Text3}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Sub, Converter={StaticResource NE2V}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Type}" FontSize="11.5"
                                               Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding HitsText}" FontSize="11.5"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Source}" FontSize="11"
                                               Foreground="{StaticResource B.Text3}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                Visibility="{Binding IsCandidate, Converter={StaticResource B2V}}">
                                        <Button Content="确认" Style="{StaticResource Btn.Outline}" FontSize="11"
                                                Height="24" Padding="8,0" Click="OnConfirmCandidate" />
                                        <Button Content="忽略" Style="{StaticResource Btn.Ghost}" FontSize="11"
                                                Height="24" Padding="8,0" Margin="4,0,0,0"
                                                Click="OnIgnoreCandidate" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                Visibility="{Binding IsPerson, Converter={StaticResource B2V}}">
                                        <Button Content="编辑" Style="{StaticResource Btn.Ghost}"
                                                FontSize="11" Height="24" Padding="8,0"
                                                Click="OnEditPerson" />
                                        <Button Content="合并" Style="{StaticResource Btn.Ghost}"
                                                FontSize="11" Height="24" Padding="8,0" Margin="2,0,0,0"
                                                ToolTip="同一个人被认成多个 tag 时，合并到其中一个"
                                                Click="OnMergePerson" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 人物条目 -->
            <Border x:Name="PersonPane" Grid.Column="4" BorderBrush="{StaticResource B.Border}"
                    BorderThickness="1" CornerRadius="10" Background="{StaticResource B.Panel}" Padding="12"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="PersonTagText" FontSize="12" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Foreground="{StaticResource B.Text2}" />
                        <Border Height="96" Margin="0,10,0,0" Background="{StaticResource B.Tile}"
                                CornerRadius="8" ClipToBounds="True">
                            <Image x:Name="PersonAvatar" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="用当前图作封面" Style="{StaticResource Btn.Outline}" Height="26"
                                    FontSize="11" Padding="8,0" Click="OnAvatarFromCurrent" />
                            <Button Content="恢复默认" Style="{StaticResource Btn.Ghost}" Height="26"
                                    FontSize="11" Padding="8,0" Margin="6,0,0,0" Click="OnAvatarReset" />
                        </StackPanel>

                        <TextBlock Text="中文名" Style="{StaticResource T.Label}" Margin="0,12,0,4" />
                        <TextBox x:Name="NameZhBox" Height="30" FontSize="12.5" VerticalContentAlignment="Center" />
                        <TextBlock Text="英文名" Style="{StaticResource T.Label}" Margin="0,8,0,4" />
                        <TextBox x:Name="NameEnBox" Height="30" FontSize="12.5" VerticalContentAlignment="Center" />
                        <TextBlock Text="作品" Style="{StaticResource T.Label}" Margin="0,8,0,4" />
                        <TextBox x:Name="WorkBox" Height="30" FontSize="12.5" VerticalContentAlignment="Center" />
                        <TextBlock Text="简介" Style="{StaticResource T.Label}" Margin="0,8,0,4" />
                        <TextBox x:Name="BioBox" Height="72" FontSize="12.5" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalContentAlignment="Top" />

                        <TextBlock Text="别名" Style="{StaticResource T.Label}" Margin="0,10,0,4" />
                        <TextBlock x:Name="AliasText" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource B.Text3}" />

                        <Button Content="保存" Style="{StaticResource Btn.Primary}" Height="32" Margin="0,12,0,0"
                                Click="OnSavePerson" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="重新识别全库" Style="{StaticResource Btn.Outline}" Height="32" Padding="12,0"
                        Click="OnRetag" />
                <Button Content="导出词表 CSV" Style="{StaticResource Btn.Ghost}" Height="32" Padding="12,0"
                        Margin="8,0,0,0" Click="OnExport" />
                <StackPanel x:Name="BatchBar" Orientation="Horizontal" Margin="16,0,0,0"
                            Visibility="Collapsed">
                    <Button x:Name="BatchIgnoreBtn" Content="忽略选中" Style="{StaticResource Btn.Outline}"
                            Height="32" Padding="12,0" Click="OnBatchIgnore" />
                    <Button x:Name="BatchConfirmBtn" Content="确认选中" Style="{StaticResource Btn.Outline}"
                            Height="32" Padding="12,0" Margin="8,0,0,0" Click="OnBatchConfirm" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource T.Sub}" FontSize="11.5"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
            <Button Content="关闭" Style="{StaticResource Btn.Primary}" Width="96" Height="32"
                    HorizontalAlignment="Right" Click="OnClose" />
        </Grid>
    </Grid>
</Window>
