<Window x:Class="LatentFolio.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="720" Width="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource B.Canvas}"
        FontFamily="{StaticResource F.UI}">
    <Window.Resources>
        <!-- 分组卡片：白底 + 描边，组间 14 -->
        <Style x:Key="P.Set.Card" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- 字段行：统一 32 高，行内控件靠右 -->
        <Style x:Key="P.Set.Row" TargetType="Grid">
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <!-- 字段名：固定 96，保证各行值列起点一致 -->
        <Style x:Key="P.Set.Label" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
            <Setter Property="Width" Value="96" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 组内次要按钮：白底描边，高 28 -->
        <Style x:Key="P.Set.Action" TargetType="Button" BasedOn="{StaticResource Btn.Outline}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <!-- 危险动作：仍是白底描边按钮，只有文字转红 -->
        <Style x:Key="P.Set.Danger" TargetType="Button" BasedOn="{StaticResource P.Set.Action}">
            <Setter Property="Foreground" Value="{StaticResource B.Danger}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource B.Danger}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource B.Danger}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 分段项（未选中）：透明底 + 次要字，悬停加深字色 -->
        <Style x:Key="P.Set.Seg" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Hover}" />
                                <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分段项（选中）：白底 + 主色字 + 卡片阴影，悬停保持白底 -->
        <Style x:Key="P.Set.SegOn" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource B.Accent}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="7"
                                    Effect="{StaticResource Fx.Card}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="设置" Style="{StaticResource T.Page}" />
        <Border Grid.Row="1" Style="{StaticResource HLine}" Margin="0,12,0,0" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
            <StackPanel>
                <!-- 图库与导入 -->
                <Border Style="{StaticResource P.Set.Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="图库与导入" Style="{StaticResource T.CardTitle}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Content="更换目录…" Style="{StaticResource P.Set.Action}"
                                        Click="OnChangeRoot" />
                                <Button Content="重新扫描" Style="{StaticResource P.Set.Action}"
                                        Margin="8,0,0,0" Click="OnRescan" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,12,0,0">
                            <Grid Style="{StaticResource P.Set.Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="输出目录" Style="{StaticResource P.Set.Label}" />
                                <TextBlock x:Name="RootText" Grid.Column="1" Style="{StaticResource T.Mono}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </Grid>
                            <!-- 判重记录：9 圆角凹槽块 -->
                            <Border Style="{StaticResource Card.Inset}" Padding="10,8" Margin="-10,8,-10,0">
                                <Grid MinHeight="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="DedupeBox" Content="同样的图只收一份（按内容哈希）"
                                              VerticalAlignment="Center" Click="OnDedupeChanged" />
                                    <Button Grid.Column="1" Content="清空判重记录" Style="{StaticResource P.Set.Danger}"
                                            Margin="12,0,0,0" VerticalAlignment="Center" Click="OnClearSkip" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 缩略图与缓存 -->
                <Border Style="{StaticResource P.Set.Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="缩略图与缓存" Style="{StaticResource T.CardTitle}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="GridCacheText" Grid.Column="1" Style="{StaticResource T.Sub}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </Grid>
                        <!-- 缩略图缓存数据：9 圆角凹槽块 -->
                        <Border Style="{StaticResource Card.Inset}" Padding="10,8" Margin="-10,12,-10,0">
                            <StackPanel>
                                <Grid Style="{StaticResource P.Set.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="归档缩略图" Style="{StaticResource P.Set.Label}" />
                                    <TextBlock x:Name="ArchiveText" Grid.Column="1" Style="{StaticResource T.Value}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Margin="12,0,0,0" />
                                </Grid>
                                <Grid Style="{StaticResource P.Set.Row}">
                                    <CheckBox x:Name="ArchiveBox" Content="为已删除图片保留预览（约 12 KB/张）"
                                              VerticalAlignment="Center" Click="OnArchiveChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Button Content="清空网格缩略图缓存" Style="{StaticResource P.Set.Danger}"
                                HorizontalAlignment="Right" Margin="0,4,-10,0" Click="OnClearCache" />
                    </StackPanel>
                </Border>

                <!-- 窗口 -->
                <Border Style="{StaticResource P.Set.Card}">
                    <StackPanel>
                        <TextBlock Text="窗口" Style="{StaticResource T.CardTitle}" />
                        <Border Style="{StaticResource Card.Inset}" Padding="10,8" Margin="-10,12,-10,0">
                            <Grid MinHeight="40">
                                <CheckBox x:Name="TrayBox" Content="关闭窗口时缩到托盘，不退出"
                                          VerticalAlignment="Center" Click="OnTrayCloseChanged" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 统计 -->
                <Border Style="{StaticResource P.Set.Card}">
                    <StackPanel>
                        <TextBlock Text="统计" Style="{StaticResource T.CardTitle}" />
                        <Grid Style="{StaticResource P.Set.Row}" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="排行门槛" Style="{StaticResource P.Set.Label}" />
                            <Border Grid.Column="1" Style="{StaticResource Seg.Track}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel x:Name="ThresholdBar" Orientation="Horizontal" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 处理 · RTX VSR -->
                <Border Style="{StaticResource P.Set.Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="处理 · RTX VSR" Style="{StaticResource T.CardTitle}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="GpuText" Grid.Column="1" Style="{StaticResource T.Sub}"
                                       TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </Grid>
                        <StackPanel Margin="0,12,0,0">
                            <Grid Style="{StaticResource P.Set.Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="模式" Style="{StaticResource P.Set.Label}" />
                                <Border Grid.Column="1" Style="{StaticResource Seg.Track}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel x:Name="ModeBar" Orientation="Horizontal" />
                                </Border>
                            </Grid>
                            <Grid Style="{StaticResource P.Set.Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="档位" Style="{StaticResource P.Set.Label}" />
                                <Border Grid.Column="1" Style="{StaticResource Seg.Track}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel x:Name="LevelBar" Orientation="Horizontal" />
                                </Border>
                            </Grid>
                            <Grid Style="{StaticResource P.Set.Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="默认放大倍数" Style="{StaticResource P.Set.Label}" />
                                <Border Grid.Column="1" Style="{StaticResource Seg.Track}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel x:Name="ScaleBar" Orientation="Horizontal" />
                                </Border>
                            </Grid>
                            <TextBlock Text="处理结果只在本次运行有效，不写库、不进 output 目录。"
                                       Style="{StaticResource T.Sub}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="关闭" Style="{StaticResource Btn.Primary}" Width="96" Height="32"
                    Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
