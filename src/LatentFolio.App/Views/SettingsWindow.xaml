<Window x:Class="LatentFolio.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="720" Width="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource B.Window}"
        FontFamily="{StaticResource F.UI}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="设置" Style="{StaticResource T.Title}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
            <StackPanel>
                <!-- 图库与导入 -->
                <TextBlock Text="图库与导入" Style="{StaticResource T.Section}" Margin="0,0,0,8" />
                <Border Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Border}"
                        BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="跟随的 ComfyUI 输出目录" Style="{StaticResource T.Label}" />
                        <TextBlock x:Name="RootText" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,10"
                                   Foreground="{StaticResource B.Text}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="更换目录…" Style="{StaticResource Btn.Outline}" Height="30"
                                    Padding="12,0" Click="OnChangeRoot" />
                            <Button Content="重新扫描" Style="{StaticResource Btn.Outline}" Height="30"
                                    Padding="12,0" Margin="8,0,0,0" Click="OnRescan" />
                        </StackPanel>
                        <CheckBox x:Name="WatchBox" Content="自动导入新图（目录监视）" Margin="0,12,0,0"
                                  FontSize="12.5" Click="OnWatchChanged" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="DedupeBox" Content="同样的图只收一份（按内容哈希）"
                                      FontSize="12.5" Click="OnDedupeChanged" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="清空判重记录" Style="{StaticResource Btn.Ghost}"
                                    FontSize="11.5" Padding="8,2" Click="OnClearSkip"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 缩略图与缓存 -->
                <TextBlock Text="缩略图与缓存" Style="{StaticResource T.Section}" Margin="0,0,0,8" />
                <Border Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Border}"
                        BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="网格缩略图缓存（可随时重建）" Style="{StaticResource T.Label}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="GridCacheText" Grid.Column="1" FontSize="12.5" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="归档缩略图（已删除/丢失，永久保留）" Style="{StaticResource T.Label}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ArchiveText" Grid.Column="1" FontSize="12.5" />
                        </Grid>
                        <CheckBox x:Name="ArchiveBox" Content="为已删除图片保留预览（约 12 KB/张）"
                                  Margin="0,12,0,0" FontSize="12.5" Click="OnArchiveChanged" />
                        <Button Content="清空网格缩略图缓存" Style="{StaticResource Btn.Outline}" Height="30"
                                Padding="12,0" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Click="OnClearCache" />
                    </StackPanel>
                </Border>

                <!-- 统计 -->
                <TextBlock Text="统计" Style="{StaticResource T.Section}" Margin="0,0,0,8" />
                <Border Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Border}"
                        BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="排行门槛" Style="{StaticResource T.Label}" VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <StackPanel x:Name="ThresholdBar" Orientation="Horizontal" />
                    </StackPanel>
                </Border>

                <!-- 处理 · RTX VSR -->
                <TextBlock Text="处理 · RTX VSR" Style="{StaticResource T.Section}" Margin="0,0,0,8" />
                <Border Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Border}"
                        BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="GpuText" FontSize="12.5" TextWrapping="Wrap" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource B.AccentSoft}" CornerRadius="12" Padding="10,4">
                                <TextBlock Text="HIGHBITRATE" FontSize="11.5" Foreground="{StaticResource B.Accent}" />
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource B.AccentSoft}" CornerRadius="12"
                                    Padding="10,4" Margin="6,0,0,0">
                                <TextBlock Text="ULTRA" FontSize="11.5" Foreground="{StaticResource B.Accent}" />
                            </Border>
                            <TextBlock Grid.Column="2" Text="已锁定" FontSize="11.5"
                                       Foreground="{StaticResource B.Text3}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="默认放大倍数" Style="{StaticResource T.Label}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel x:Name="ScaleBar" Orientation="Horizontal" />
                        </StackPanel>
                        <TextBlock Text="处理结果只在本次运行有效，不写库、不进 output 目录。"
                                   FontSize="11.5" Foreground="{StaticResource B.Text3}"
                                   Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="关闭" Style="{StaticResource Btn.Primary}" Width="96" Height="34"
                    Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
