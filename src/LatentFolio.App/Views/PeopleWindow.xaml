<Window x:Class="LatentFolio.App.Views.PeopleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:LatentFolio.App.Controls"
        Title="人物" Height="760" Width="1080"
        WindowStartupLocation="CenterOwner" Background="{StaticResource B.Window}"
        FontFamily="{StaticResource F.UI}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="人物" Style="{StaticResource T.Title}" VerticalAlignment="Center" />
            <TextBox x:Name="FilterBox" Width="240" Height="32" Margin="16,0,0,0"
                     VerticalContentAlignment="Center" FontSize="12.5" TextChanged="OnFilter" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Host">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="9" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4" Cursor="Hand" MouseLeftButtonDown="OnPick"
                                    MouseRightButtonUp="OnPickAvatar"
                                    ToolTip="左键看这个角色的图 · 右键换头像">
                            <Border Height="96" Background="{StaticResource B.Tile}" CornerRadius="8" ClipToBounds="True">
                                <Image c:ThumbLoader.SourceItem="{Binding}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{Binding Display}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Margin="1,4,1,0" />
                            <TextBlock Text="{Binding Count}" FontSize="10.5" Foreground="{StaticResource B.Text3}"
                                       Margin="1,1,1,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
