<Window x:Class="LatentFolio.App.Views.PeopleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:LatentFolio.App.Controls"
        Title="人物" Height="760" Width="1080"
        WindowStartupLocation="CenterOwner" Background="{StaticResource B.Window}"
        FontFamily="{StaticResource F.UI}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="人物" Style="{StaticResource T.Title}" VerticalAlignment="Center" />
            <TextBox x:Name="FilterBox" Grid.Column="1" Width="220" Height="32" Margin="16,0,0,0"
                     VerticalContentAlignment="Center" FontSize="12.5" TextChanged="OnFilter"
                     AutomationProperties.Name="搜索人物" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        HorizontalAlignment="Right" Margin="0,0,12,0">
                <TextBlock Text="排序" Style="{StaticResource T.Label}" VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ComboBox x:Name="SortBox" Width="130" SelectedIndex="0" SelectionChanged="OnSort">
                    <ComboBoxItem Content="张数 · 多在前" />
                    <ComboBoxItem Content="中文名 · A-Z" />
                    <ComboBoxItem Content="tag · A-Z" />
                </ComboBox>
                <CheckBox x:Name="OnlyZhBox" Content="只看有中文名" FontSize="12" Height="24" Margin="14,0,0,0"
                          VerticalAlignment="Center" Click="OnFilterToggle" />
            </StackPanel>

            <Button Grid.Column="3" Content="候选池" Style="{StaticResource Btn.Outline}" Height="30"
                    Padding="12,0" Click="OnCandidates" AutomationProperties.Name="候选池" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Host">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="9" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4" Cursor="Hand" MouseLeftButtonDown="OnPick"
                                    MouseRightButtonUp="OnPickAvatar"
                                    ToolTip="左键看这个角色的图 · 右键换头像">
                            <Border Height="96" Background="{StaticResource B.Tile}" CornerRadius="8" ClipToBounds="True">
                                <Image c:ThumbLoader.SourceItem="{Binding}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{Binding Display}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Margin="1,4,1,0" />
                            <TextBlock Text="{Binding Count}" FontSize="10.5" Foreground="{StaticResource B.Text3}"
                                       Margin="1,1,1,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
