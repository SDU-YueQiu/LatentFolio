<Window x:Class="LatentFolio.App.Views.TagDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="标签" Height="460" Width="420"
        WindowStartupLocation="CenterOwner" Background="{StaticResource B.Window}"
        FontFamily="{StaticResource F.UI}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Style="{StaticResource T.Title}" />

        <Border Grid.Row="1" Margin="0,12,0,10" BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                CornerRadius="9" Background="{StaticResource B.Panel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                <StackPanel x:Name="ListHost" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewTagBox" Height="32" VerticalContentAlignment="Center" FontSize="12.5" />
            <Button Grid.Column="1" Content="新建并勾选" Style="{StaticResource Btn.Primary}" Height="32"
                    Margin="8,0,0,0" Click="OnCreateTag" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Style="{StaticResource Btn.Outline}" Width="84" Height="34" Click="OnCancel" />
            <Button Content="确定" Style="{StaticResource Btn.Primary}" Width="90" Height="34" Margin="10,0,0,0"
                    Click="OnOk" />
        </StackPanel>
    </Grid>
</Window>
