<UserControl x:Class="LatentFolio.App.Views.DetailPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:LatentFolio.App.Controls" Background="Transparent">
    <UserControl.Resources>
        <!-- ===== 段落骨架：标题行 22 + 段内字段行 24，段与段之间靠外层 Margin 14 ===== -->
        <Style x:Key="P.Detail.SectionHead" TargetType="Grid">
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="P.Detail.Section" TargetType="TextBlock" BasedOn="{StaticResource T.Section}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="P.Detail.Row" TargetType="Grid">
            <Setter Property="Height" Value="24" />
        </Style>
        <!-- 标签灰、值黑：字段行左标签 11.5 / 值 12.5，全部左对齐到同一条值轴 -->
        <Style x:Key="P.Detail.FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource T.Sub}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="P.Detail.FieldValue" TargetType="TextBlock" BasedOn="{StaticResource T.Value}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- 路径 / 种子 / 参数一律等宽，且抬到主文字色，避免右栏整体发灰 -->
        <Style x:Key="P.Detail.FieldMono" TargetType="TextBlock" BasedOn="{StaticResource T.Mono}">
            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- ===== 可选中版本（TextBlock 换 TextBox）：右栏所有静态文字都能拖选/复制 ===== -->
        <Style x:Key="P.Detail.SelHead" TargetType="{x:Type c:SelectableText}" BasedOn="{StaticResource S.Section}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="P.Detail.SelLabel" TargetType="{x:Type c:SelectableText}" BasedOn="{StaticResource S.Sub}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="P.Detail.SelValue" TargetType="{x:Type c:SelectableText}" BasedOn="{StaticResource S.Value}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="P.Detail.SelMono" TargetType="{x:Type c:SelectableText}" BasedOn="{StaticResource S.Mono}">
            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 顶部模型行：没解析出模型时整行隐藏（ModelText 用 — 兜底） -->
        <Style x:Key="P.Detail.ModelRow" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Current.ModelText}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Current.ModelText}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Current.ModelText}" Value="—">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- ===== 备注：凹槽底、无可见描边、圆角 9、高 44，聚焦时白底 + 主色描边 ===== -->
        <Style x:Key="P.Detail.Note" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="44" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
            <Setter Property="Background" Value="{StaticResource B.Inset}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="White" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ===== 提示词：凹槽底、圆角 10、左右 padding 10 / 上下 8 ===== -->
        <Style x:Key="P.Detail.InsetBlock" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource B.Inset}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <!-- 提示词正文：只读 TextBox，能拖选 / Ctrl+C；透明无描边，凹槽外观由外层 Border 给 -->
        <Style x:Key="P.Detail.PromptBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,0,10,0" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}" HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 角色 tag 行：可点复制，文字临时换「已复制」 -->
        <Style x:Key="P.Detail.TagLink" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,0,10,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource B.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 画师小标签：凹槽底、圆角 8，可点复制 -->
        <Style x:Key="P.Detail.ArtistChip" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
            <Setter Property="Background" Value="{StaticResource B.Inset}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 文字复制按钮：高 24 / 11.5 / Text3，悬停文字转主色（不抢段落标题） -->
        <Style x:Key="P.Detail.CopyText" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource B.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ===== 工作流展开项：一行 32 的可点行（E70D/E70E + T.Label），内容区凹槽底 ===== -->
        <Style x:Key="P.Detail.Expander" TargetType="Expander">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite" Focusable="True" Cursor="Hand" FocusVisualStyle="{x:Null}" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Height="32" Padding="8,0" CornerRadius="9" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="chev" Text="" FontFamily="{StaticResource F.Icon}" FontSize="10" Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" />
                                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" RecognizesAccessKey="False" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Hover}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="chev" Property="Text" Value="" />
                                                <Setter TargetName="chev" Property="Foreground" Value="{StaticResource B.Text2}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" ContentSource="Content" HorizontalAlignment="Stretch" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="P.Detail.WorkflowPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource B.Inset}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <!-- 工作流 JSON：透明底、无描边，横向不折行，自身滚动 -->
        <Style x:Key="P.Detail.CodeBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,0,10,0" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}" HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent" FocusVisualStyle="{x:Null}">
        <StackPanel Margin="16,16,16,24">
            <!-- ===== 顶部：文件名最多两行，下面一行元信息 ===== -->
            <c:SelectableText Text="{Binding Current.FileName, Mode=OneWay}" Style="{StaticResource S.Title}"
                              TextWrapping="Wrap" MaxHeight="40" ToolTip="{Binding Current.FileName}" />
            <c:SelectableText Text="{Binding Current.MetaText, Mode=OneWay}" Style="{StaticResource S.Sub}" Margin="0,4,0,0" />
            <Grid Style="{StaticResource P.Detail.ModelRow}" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:SelectableText Text="模型" Style="{StaticResource P.Detail.SelLabel}" />
                <c:SelectableText Grid.Column="1" Text="{Binding Current.ModelText, Mode=OneWay}"
                                  Style="{StaticResource P.Detail.SelMono}" ToolTip="{Binding Current.ModelText}" />
            </Grid>
            <!-- ===== 评分与备注 ===== -->
            <StackPanel Margin="0,14,0,0">
                <Grid Style="{StaticResource P.Detail.SectionHead}">
                    <c:SelectableText Text="评分与备注" Style="{StaticResource P.Detail.SelHead}" />
                </Grid>
                <c:RatingBar Value="{Binding Current.Rating, Mode=TwoWay}" StarSize="20" Gap="4" Height="24" HorizontalAlignment="Left" />
                <TextBox Style="{StaticResource P.Detail.Note}" Margin="0,8,0,0" Text="{Binding Current.Note, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
            </StackPanel>
            <!-- ===== 文件 ===== -->
            <StackPanel Margin="0,14,0,0">
                <Grid Style="{StaticResource P.Detail.SectionHead}">
                    <c:SelectableText Text="文件" Style="{StaticResource P.Detail.SelHead}" />
                </Grid>
                <Grid Style="{StaticResource P.Detail.Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:SelectableText Text="文件夹" Style="{StaticResource P.Detail.SelLabel}" />
                    <c:SelectableText Grid.Column="1" Text="{Binding Current.Folder, Mode=OneWay}"
                                      Style="{StaticResource P.Detail.SelMono}" ToolTip="{Binding Current.Folder}" />
                </Grid>
                <Grid Style="{StaticResource P.Detail.Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:SelectableText Text="日期" Style="{StaticResource P.Detail.SelLabel}" />
                    <c:SelectableText Grid.Column="1" Text="{Binding Current.DateText, Mode=OneWay}" Style="{StaticResource P.Detail.SelValue}" />
                </Grid>
            </StackPanel>
            <!-- ===== 人物（角色 + 画师）：任一有内容就显示；都没有时整块隐藏 ===== -->
            <StackPanel Margin="0,14,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Current.HasPeople}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Current.HasArtists}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid Style="{StaticResource P.Detail.SectionHead}">
                    <c:SelectableText Text="人物" Style="{StaticResource P.Detail.SelHead}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Current.People}" Visibility="{Binding Current.HasPeople, Converter={StaticResource B2V}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6" Cursor="Hand" Background="Transparent" MouseLeftButtonDown="OnPersonRowClick" MouseRightButtonDown="OnPersonRowRightDown" AutomationProperties.Name="{Binding Display}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="8" ClipToBounds="True" Background="{StaticResource B.Inset}">
                                    <Image c:ThumbLoader.SourceItem="{Binding}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Display}" Style="{StaticResource T.Value}" TextTrimming="CharacterEllipsis" />
                                    <Button Style="{StaticResource P.Detail.TagLink}" Content="{Binding Tag}" Click="OnPersonTagClick">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Current.Artists}" Visibility="{Binding Current.HasArtists, Converter={StaticResource B2V}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource P.Detail.ArtistChip}" Content="{Binding}" Click="OnArtistChipClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <!-- ===== 正向提示词 ===== -->
            <StackPanel Margin="0,14,0,0">
                <Grid Style="{StaticResource P.Detail.SectionHead}">
                    <c:SelectableText Text="正向提示词" Style="{StaticResource P.Detail.SelHead}" />
                    <Button Style="{StaticResource P.Detail.CopyText}" Content="复制" Click="OnCopyPrompt" />
                </Grid>
                <Border Style="{StaticResource P.Detail.InsetBlock}" MaxHeight="260">
                    <TextBox Style="{StaticResource P.Detail.PromptBox}" Text="{Binding Current.Prompt, Mode=OneWay}" />
                </Border>
            </StackPanel>
            <!-- ===== 负面提示词 ===== -->
            <StackPanel Margin="0,14,0,0" Visibility="{Binding Current.HasNegative, Converter={StaticResource B2V}}">
                <Grid Style="{StaticResource P.Detail.SectionHead}">
                    <c:SelectableText Text="负面提示词" Style="{StaticResource P.Detail.SelHead}" />
                    <Button Style="{StaticResource P.Detail.CopyText}" Content="复制" Click="OnCopyNegative" />
                </Grid>
                <c:SelectableText Text="{Binding Current.NegHint, Mode=OneWay}" TextWrapping="Wrap" FontSize="11"
                                  Foreground="{StaticResource B.Danger}" Margin="0,0,0,6"
                                  VerticalContentAlignment="Top"
                                  Visibility="{Binding Current.NegHint, Converter={StaticResource NE2V}}" />
                <Border Style="{StaticResource P.Detail.InsetBlock}" MaxHeight="140">
                    <TextBox Style="{StaticResource P.Detail.PromptBox}" Text="{Binding Current.Negative, Mode=OneWay}" />
                </Border>
            </StackPanel>
            <!-- ===== 采样参数 ===== -->
            <StackPanel Margin="0,14,0,0">
                <Grid Style="{StaticResource P.Detail.SectionHead}">
                    <c:SelectableText Text="采样参数" Style="{StaticResource P.Detail.SelHead}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding CurrentParams}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Style="{StaticResource P.Detail.Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <c:SelectableText Text="{Binding Key, Mode=OneWay}" Style="{StaticResource P.Detail.SelLabel}" />
                                <c:SelectableText Grid.Column="1" Text="{Binding Value, Mode=OneWay}"
                                                  Style="{StaticResource P.Detail.SelMono}" ToolTip="{Binding Value}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <!-- ===== 工作流 ===== -->
            <Expander x:Name="WorkflowExpander" Header="{Binding WorkflowHeader}" Style="{StaticResource P.Detail.Expander}" Margin="0,14,0,0" Expanded="OnWorkflowExpanded">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource T.Label}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <Border Style="{StaticResource P.Detail.WorkflowPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button Content="复制工作流" Style="{StaticResource P.Detail.CopyText}" Margin="0,0,0,6" Click="OnCopyWorkflow" AutomationProperties.Name="复制工作流" />
                        <TextBox Grid.Row="1" Style="{StaticResource P.Detail.CodeBox}" Text="{Binding WorkflowText, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" MaxHeight="420" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>