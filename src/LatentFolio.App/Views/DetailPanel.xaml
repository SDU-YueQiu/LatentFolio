<UserControl x:Class="LatentFolio.App.Views.DetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LatentFolio.App.Controls"
             Background="Transparent">
    <UserControl.Resources>

        <!-- ===== 段落骨架：标题行 22 + 段内字段行 24，段与段之间靠外层 Margin 14 ===== -->
        <Style x:Key="P.Detail.SectionHead" TargetType="Grid">
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="P.Detail.Section" TargetType="TextBlock" BasedOn="{StaticResource T.Section}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="P.Detail.Row" TargetType="Grid">
            <Setter Property="Height" Value="24" />
        </Style>

        <!-- 标签灰、值黑：字段行左标签 11.5 / 值 12.5，全部左对齐到同一条值轴 -->
        <Style x:Key="P.Detail.FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource T.Sub}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="P.Detail.FieldValue" TargetType="TextBlock" BasedOn="{StaticResource T.Value}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- 路径 / 种子 / 参数一律等宽，且抬到主文字色，避免右栏整体发灰 -->
        <Style x:Key="P.Detail.FieldMono" TargetType="TextBlock" BasedOn="{StaticResource T.Mono}">
            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- ===== 备注：凹槽底、无可见描边、圆角 9、高 56，聚焦时白底 + 主色描边 ===== -->
        <Style x:Key="P.Detail.Note" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="56" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
            <Setter Property="Background" Value="{StaticResource B.Inset}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="White" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 提示词：凹槽底、圆角 10、左右 padding 10 / 上下 8，等宽 11.5 / 行高 17 ===== -->
        <Style x:Key="P.Detail.InsetBlock" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource B.Inset}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style x:Key="P.Detail.PromptText" TargetType="TextBlock" BasedOn="{StaticResource T.Mono}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="P.Detail.Tag" TargetType="TextBlock" BasedOn="{StaticResource T.Sub}">
            <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 文字复制按钮：高 24 / 11.5 / Text3，悬停文字转主色（不抢段落标题） -->
        <Style x:Key="P.Detail.CopyText" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource B.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== 工作流展开项：一行 32 的可点行（E70D/E70E + T.Label），内容区凹槽底 ===== -->
        <Style x:Key="P.Detail.Expander" TargetType="Expander">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite" Focusable="True" Cursor="Hand"
                                          FocusVisualStyle="{x:Null}"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Height="32" Padding="8,0" CornerRadius="9"
                                                Background="Transparent" BorderBrush="Transparent"
                                                BorderThickness="1" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="chev" Text="&#xE70D;"
                                                           FontFamily="{StaticResource F.Icon}" FontSize="10"
                                                           Foreground="{StaticResource B.Text3}"
                                                           VerticalAlignment="Center" />
                                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  RecognizesAccessKey="False" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Hover}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="chev" Property="Text" Value="&#xE70E;" />
                                                <Setter TargetName="chev" Property="Foreground" Value="{StaticResource B.Text2}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" ContentSource="Content"
                                              HorizontalAlignment="Stretch" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="P.Detail.WorkflowPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource B.Inset}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <!-- 工作流 JSON：透明底、无描边，横向不折行，自身滚动 -->
        <Style x:Key="P.Detail.CodeBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
        <StackPanel Margin="16,16,16,24">

            <!-- ===== 顶部：文件名最多两行，下面一行元信息 ===== -->
            <TextBlock Text="{Binding Current.FileName}" Style="{StaticResource T.Title}"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       LineHeight="20" LineStackingStrategy="BlockLineHeight" MaxHeight="40"
                       ToolTip="{Binding Current.FileName}" />
            <TextBlock Style="{StaticResource T.Sub}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Current.Resolution, Mode=OneWay}"
                     FontFamily="{StaticResource F.Mono}" />
                <Run Text=" · " />
                <Run Text="{Binding Current.SizeText, Mode=OneWay}"
                     FontFamily="{StaticResource F.Mono}" />
                <Run Text=" · " />
                <Run Text="{Binding Current.ExtText, Mode=OneWay}" />
            </TextBlock>

            <!-- ===== 评分与备注 ===== -->
            <StackPanel Margin="0,14,0,0">
                <Grid Style="{StaticResource P.Detail.SectionHead}">
                    <TextBlock Text="评分与备注" Style="{StaticResource P.Detail.Section}" />
                </Grid>
                <c:RatingBar Value="{Binding Current.Rating, Mode=TwoWay}" StarSize="20" Gap="4"
                             Height="24" HorizontalAlignment="Left" />
                <TextBox Style="{StaticResource P.Detail.Note}" Margin="0,8,0,0"
                         Text="{Binding Current.Note, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
            </StackPanel>

            <!-- ===== 文件 ===== -->
            <StackPanel Margin="0,14,0,0">
                <Grid Style="{StaticResource P.Detail.SectionHead}">
                    <TextBlock Text="文件" Style="{StaticResource P.Detail.Section}" />
                </Grid>
                <Grid Style="{StaticResource P.Detail.Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="文件夹" Style="{StaticResource P.Detail.FieldLabel}" />
                    <TextBlock Grid.Column="1" Text="{Binding Current.Folder}"
                               Style="{StaticResource P.Detail.FieldMono}"
                               ToolTip="{Binding Current.Folder}" />
                </Grid>
                <Grid Style="{StaticResource P.Detail.Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="日期" Style="{StaticResource P.Detail.FieldLabel}" />
                    <TextBlock Grid.Column="1" Text="{Binding Current.DateText}"
                               Style="{StaticResource P.Detail.FieldValue}" />
                </Grid>
            </StackPanel>

            <!-- ===== 人物 ===== -->
            <StackPanel Margin="0,14,0,0" Visibility="{Binding Current.HasPeople, Converter={StaticResource B2V}}">
                <Grid Style="{StaticResource P.Detail.SectionHead}">
                    <TextBlock Text="人物" Style="{StaticResource P.Detail.Section}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Current.People}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6" Cursor="Hand" Background="Transparent"
                                  MouseLeftButtonDown="OnPersonRowClick"
                                  MouseRightButtonDown="OnPersonRowRightDown"
                                  AutomationProperties.Name="{Binding Display}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="8" ClipToBounds="True"
                                        Background="{StaticResource B.Inset}">
                                    <Image c:ThumbLoader.SourceItem="{Binding}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Display}" Style="{StaticResource T.Value}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Tag}" Style="{StaticResource T.Sub}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== 画师 ===== -->
            <StackPanel Margin="0,14,0,0" Visibility="{Binding Current.HasArtists, Converter={StaticResource B2V}}">
                <Grid Style="{StaticResource P.Detail.SectionHead}">
                    <TextBlock Text="画师" Style="{StaticResource P.Detail.Section}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Current.Artists}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource B.Inset}" CornerRadius="999" Padding="8,4"
                                    Margin="0,0,6,6">
                                <TextBlock Text="{Binding}" Style="{StaticResource P.Detail.Tag}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== 正向提示词 ===== -->
            <StackPanel Margin="0,14,0,0">
                <Grid Style="{StaticResource P.Detail.SectionHead}">
                    <TextBlock Text="正向提示词" Style="{StaticResource P.Detail.Section}" />
                    <Button Style="{StaticResource P.Detail.CopyText}" Content="复制"
                            Click="OnCopyPrompt" />
                </Grid>
                <Border Style="{StaticResource P.Detail.InsetBlock}" MaxHeight="135">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto" Focusable="False">
                        <TextBlock Text="{Binding Current.Prompt, Mode=OneWay}"
                                   Style="{StaticResource P.Detail.PromptText}" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- ===== 负面提示词 ===== -->
            <StackPanel Margin="0,14,0,0"
                        Visibility="{Binding Current.HasNegative, Converter={StaticResource B2V}}">
                <Grid Style="{StaticResource P.Detail.SectionHead}">
                    <TextBlock Text="负面提示词" Style="{StaticResource P.Detail.Section}" />
                    <Button Style="{StaticResource P.Detail.CopyText}" Content="复制"
                            Click="OnCopyNegative" />
                </Grid>
                <TextBlock Text="{Binding Current.NegHint}" TextWrapping="Wrap" FontSize="11"
                           Foreground="{StaticResource B.Danger}" Margin="0,0,0,6"
                           Visibility="{Binding Current.NegHint, Converter={StaticResource NE2V}}" />
                <Border Style="{StaticResource P.Detail.InsetBlock}" MaxHeight="50">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto" Focusable="False">
                        <TextBlock Text="{Binding Current.Negative, Mode=OneWay}"
                                   Style="{StaticResource P.Detail.PromptText}" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- ===== 采样参数 ===== -->
            <StackPanel Margin="0,14,0,0">
                <Grid Style="{StaticResource P.Detail.SectionHead}">
                    <TextBlock Text="采样参数" Style="{StaticResource P.Detail.Section}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding CurrentParams}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Style="{StaticResource P.Detail.Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Key}" Style="{StaticResource P.Detail.FieldLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}"
                                           Style="{StaticResource P.Detail.FieldMono}"
                                           ToolTip="{Binding Value}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== 工作流 ===== -->
            <Expander x:Name="WorkflowExpander" Header="{Binding WorkflowHeader}"
                      Style="{StaticResource P.Detail.Expander}" Margin="0,14,0,0"
                      Expanded="OnWorkflowExpanded">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource T.Label}"
                                   TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <Border Style="{StaticResource P.Detail.WorkflowPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button Content="复制工作流" Style="{StaticResource P.Detail.CopyText}"
                                Margin="0,0,0,6"
                                Click="OnCopyWorkflow" AutomationProperties.Name="复制工作流" />
                        <TextBox Grid.Row="1" Style="{StaticResource P.Detail.CodeBox}"
                                 Text="{Binding WorkflowText, Mode=OneWay}" IsReadOnly="True"
                                 TextWrapping="NoWrap" MaxHeight="420"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
