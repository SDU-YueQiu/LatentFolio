<Window x:Class="LatentFolio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:LatentFolio.App.Controls"
        xmlns:vm="clr-namespace:LatentFolio.App.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LatentFolio" Height="1000" Width="1600" MinHeight="620" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource B.Window}"
        WindowStyle="None"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <c:BoolToVis x:Key="B2V" />
        <c:BoolToVis x:Key="InvB2V" Invert="True" />
        <c:NotEmptyToVis x:Key="NE2V" />
        <c:IntToVis x:Key="I2V" />
        <c:Num x:Key="Num" />

        <!-- 一个格子 -->
        <DataTemplate x:Key="TileTpl" DataType="{x:Type vm:ImageVm}">
            <Grid Margin="0,0,0,0" Background="Transparent" AutomationProperties.Name="{Binding FileName}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource B.Tile}" CornerRadius="6" ClipToBounds="True">
                    <Image c:ThumbLoader.SourceItem="{Binding}" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <TextBlock Grid.Row="1" Text="{Binding FileName}" FontSize="11.5"
                           Foreground="{StaticResource B.Text2}" TextTrimming="CharacterEllipsis"
                           Margin="1,5,1,0" />

                <c:RatingBar Grid.Row="2" Value="{Binding Rating, Mode=OneWay}" DotSize="7" Gap="4"
                             VerticalAlignment="Center" Margin="1,3,0,0" RatingChanged="OnTileRating" />
            </Grid>
        </DataTemplate>

        <Style x:Key="TileBox" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="sel" Background="Transparent" CornerRadius="8"
                                BorderThickness="2" BorderBrush="Transparent" Padding="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="sel" Property="Background" Value="{StaticResource B.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="sel" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                                <Setter TargetName="sel" Property="Background" Value="{StaticResource B.Sel}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 人物头像 -->
        <DataTemplate x:Key="PersonTpl" DataType="{x:Type vm:PersonVm}">
            <Border Background="{StaticResource B.Tile}" CornerRadius="6" Margin="2" ClipToBounds="True"
                    ToolTip="{Binding Display}">
                <Image c:ThumbLoader.SourceItem="{Binding}" Stretch="UniformToFill" />
            </Border>
        </DataTemplate>

        <!-- 键值行 -->
        <DataTemplate x:Key="KV">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Key}" Style="{StaticResource T.Label}" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                           FontSize="12.5" Foreground="{StaticResource B.Text}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid Grid.Row="0" Background="{StaticResource B.Window}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource B.Accent}">
                    <TextBlock Text="L" Foreground="White" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="LatentFolio" Style="{StaticResource T.Title}" Margin="10,0,0,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding LibrarySummary}" Style="{StaticResource T.Sub}" Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Border Grid.Column="1" Height="32" MaxWidth="520" Margin="24,0"
                    Background="{StaticResource B.Panel}" CornerRadius="16"
                    BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                    VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="{StaticResource B.Text3}" Margin="12,0,6,0"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent" Padding="0,6,10,6"
                             VerticalContentAlignment="Center" FontSize="12.5"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Width="40" Height="34" Style="{StaticResource Btn.Ghost}" Click="OnScanClick" ToolTip="重新扫描图库" AutomationProperties.Name="重新扫描"><Button.Content><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource B.Text2}" /></Button.Content></Button>
                <Button Width="40" Height="34" Style="{StaticResource Btn.Ghost}" Click="OnMinClick"><Button.Content><TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource B.Text2}" /></Button.Content></Button>
                <Button x:Name="MaxBtn" Width="40" Height="34" Style="{StaticResource Btn.Ghost}" Click="OnMaxClick"><Button.Content><TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource B.Text2}" /></Button.Content></Button>
                <Button Width="40" Height="34" Style="{StaticResource Btn.Ghost}" Click="OnCloseClick"><Button.Content><TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource B.Text2}" /></Button.Content></Button>
            </StackPanel>
        </Grid>

        <!-- 主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左栏 -->
            <Grid Grid.Column="0" Background="{StaticResource B.Panel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 总览 / 我的栏 -->
                <StackPanel Grid.Row="0" Margin="8,8,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource Btn.Ghost}" HorizontalContentAlignment="Stretch"
                                Click="OnOverviewClick" Padding="10,7" AutomationProperties.Name="总览">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="总览 · 全部图片" Margin="9,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding TotalCount, StringFormat={}{0:N0}}" Style="{StaticResource T.Sub}"
                                           VerticalAlignment="Center" Margin="14,0,0,0" />
                            </Grid>
                        </Button>
                        <Button Grid.Column="1" Content="统计" FontSize="11.5" Padding="10,3"
                                Style="{StaticResource Btn.Ghost}" Click="OnStatsClick"
                                AutomationProperties.Name="统计" Margin="2,0,0,0" />
                    </Grid>

                    <Grid Margin="10,14,4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="我的栏" Style="{StaticResource T.Section}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="+ 新建" Style="{StaticResource Btn.Ghost}"
                                FontSize="11.5" Padding="7,3" Click="OnNewColumnClick" />
                    </Grid>
                </StackPanel>

                <ListBox Grid.Row="1" x:Name="ColList" Background="Transparent" BorderThickness="0"
                         Margin="8,0,8,0" MaxHeight="260" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemsSource="{Binding Columns}" SelectionChanged="OnColumnSelected"
                         ItemContainerStyle="{StaticResource RowItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ColumnVm}">
                            <Grid AutomationProperties.Name="{Binding Name}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="7" Height="7" Fill="{StaticResource B.Text3}" VerticalAlignment="Center"
                                         Margin="1,0,8,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" FontSize="12.5" />
                                <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource T.Sub}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource HLine}" Margin="14,6,14,10" />

                        <Grid Margin="18,0,16,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="人物" Style="{StaticResource T.Section}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource Btn.Ghost}" FontSize="11.5" Padding="6,2"
                                    Click="OnPeopleClick">
                                <TextBlock Text="全部 ›" Foreground="{StaticResource B.Text3}" />
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding PeoplePreview}" Margin="12,0,8,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="40" Margin="2" Background="{StaticResource B.Tile}" CornerRadius="6"
                                            ClipToBounds="True" MouseLeftButtonDown="OnPersonClick"
                                            Cursor="Hand">
                                        <Image c:ThumbLoader.SourceItem="{Binding}" Stretch="UniformToFill" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource HLine}" Margin="14,8,14,10" />

                        <Grid Margin="18,0,16,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="资源库" Style="{StaticResource T.Section}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="…"
                                    Style="{StaticResource Btn.Ghost}" FontSize="13" Padding="8,2"
                                    VerticalAlignment="Center" Click="OnLibraryMenu"
                                    AutomationProperties.Name="图库目录菜单" ToolTip="{Binding LibraryRoot}" />
                        </Grid>
                        <ListBox x:Name="FolderList" Background="Transparent" BorderThickness="0" Margin="8,0,8,0"
                                 MaxHeight="320" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemsSource="{Binding Folders}" SelectionChanged="OnFolderSelected"
                                 ItemContainerStyle="{StaticResource RowItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FolderVm}">
                                    <Grid AutomationProperties.Name="{Binding Display}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Display}" Margin="{Binding DepthText}" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource T.Sub}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Style="{StaticResource HLine}" Margin="14,10,14,10" />

                        <CheckBox Content="自动导入新图" Margin="14,0,14,10" FontSize="12" Height="24"
                                  IsChecked="{Binding WatchEnabled}" />

                        <Button Style="{StaticResource Btn.Ghost}" HorizontalContentAlignment="Stretch"
                                Margin="8,0,8,10" Padding="10,7" Click="OnDeletedClick" AutomationProperties.Name="已删除">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="已删除" Margin="9,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource B.Text2}" />
                                <TextBlock Grid.Column="2" Text="{Binding DeletedCount, StringFormat={}{0:N0}}"
                                           Style="{StaticResource T.Sub}" VerticalAlignment="Center" Margin="14,0,0,0" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource B.Border}" />

            <!-- 内容区 -->
            <Grid Grid.Column="2">
                <!-- 图库 -->
                <Grid x:Name="LibraryPane">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,14,20,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource T.Title}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding HitCount, StringFormat={}{0:N0} 张}" Style="{StaticResource T.Sub}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                            <Button Content="编辑条件" Style="{StaticResource Btn.Ghost}" FontSize="12"
                                    Margin="8,0,0,0" Padding="8,3" Click="OnEditColumnClick" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="排序" Style="{StaticResource T.Label}" VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <ComboBox x:Name="SortBox" Width="168" SelectedIndex="0" SelectionChanged="OnSortChanged">
                                <ComboBoxItem Content="添加时间 · 新在前" />
                                <ComboBoxItem Content="添加时间 · 旧在前" />
                                <ComboBoxItem Content="评分 · 高在前" />
                                <ComboBoxItem Content="评分 · 低在前" />
                                <ComboBoxItem Content="文件名 · A-Z" />
                                <ComboBoxItem Content="分辨率 · 大在前" />
                                <ComboBoxItem Content="文件大小 · 大在前" />
                            </ComboBox>
                            <TextBlock Text="尺寸" Style="{StaticResource T.Label}" VerticalAlignment="Center"
                                       Margin="14,0,6,0" />
                            <Slider x:Name="SizeSlider" Width="100" Minimum="110" Maximum="380" Value="190"
                                    VerticalAlignment="Center" ValueChanged="OnSizeChanged" />
                        </StackPanel>

                        <ItemsControl Grid.Row="1" Grid.ColumnSpan="3" ItemsSource="{Binding Chips}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="{StaticResource B.Border}"
                                            BorderThickness="1" CornerRadius="13" Padding="10,4" Margin="0,0,7,6">
                                        <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{StaticResource B.Text2}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <ListBox Grid.Row="1" x:Name="GridList" Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding Items}" SelectionMode="Extended"
                             ItemContainerStyle="{StaticResource TileBox}"
                             ItemTemplate="{StaticResource TileTpl}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Standard"
                             SelectionChanged="OnGridSelectionChanged"
                             MouseDoubleClick="OnGridDoubleClick"
                             KeyDown="OnGridKeyDown"
                             PreviewMouseRightButtonDown="OnGridPreviewRightDown"
                             PreviewMouseRightButtonUp="OnGridRightUp">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <c:VirtualizingWrapPanel ItemWidth="{Binding TileSize}"
                                                         ItemHeight="{Binding TileHeight}"
                                                         Spacing="8" Pad="16,4,16,24" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <TextBlock Grid.Row="1" Text="这里一张都没有" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource B.Text3}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource B2V}}" />
                </Grid>

                <!-- 查看器 -->
                <Grid x:Name="ViewerPane" Visibility="{Binding ViewerOpen, Converter={StaticResource B2V}}"
                      Background="{StaticResource B.Window}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="18,12,14,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Btn.Ghost}" Click="OnCloseViewer"
                                    Padding="8,4">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" />
                                        <TextBlock Text="返回" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                            <TextBlock Text="{Binding Current.FileName}" FontSize="14" FontWeight="SemiBold"
                                       Margin="14,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Current.Resolution}" Style="{StaticResource T.Sub}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                            <Border Background="{StaticResource B.AccentSoft}" CornerRadius="10" Padding="8,2"
                                    Margin="10,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding VsrBadge, Converter={StaticResource NE2V}}">
                                <TextBlock Text="{Binding VsrBadge}" FontSize="11"
                                           Foreground="{StaticResource B.Accent}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="RTX VSR" AutomationProperties.Name="RTX VSR 按钮" Style="{StaticResource Btn.Outline}" Padding="10,4"
                                    FontSize="12" Click="OnVsrClick" Margin="0,0,6,0" />
                            <Button Style="{StaticResource Btn.Ghost}" Padding="10,4" Click="OnToggleOriginal" ToolTip="显示原图"><Button.Content><TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource B.Text2}" /></Button.Content></Button>
                            <Button Style="{StaticResource Btn.Ghost}" Click="OnPrev" Padding="10,5" ToolTip="上一张"><Button.Content><TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource B.Text2}" /></Button.Content></Button>
                            <Button Style="{StaticResource Btn.Ghost}" Click="OnNext" Padding="10,5" ToolTip="下一张"><Button.Content><TextBlock Text="&#xE7A8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource B.Text2}" /></Button.Content></Button>
                            <Button Content="在文件夹中显示" Style="{StaticResource Btn.Ghost}" Padding="10,5"
                                    Click="OnReveal" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- 图片区 -->
                    <Border Grid.Row="1" Grid.Column="0" Background="#FF17191C" Margin="0,0,0,0" ClipToBounds="True">
                        <Grid>
                            <c:ZoomBox x:Name="BigZoom" Margin="0">
                                <Image x:Name="BigImage" Source="{Binding ViewerImage.Source}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" Margin="12"
                                       PreviewMouseRightButtonUp="OnViewerRightUp" />
                            </c:ZoomBox>
                            <TextBlock Text="加载中…" Foreground="#99FFFFFF" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding ViewerLoading, Converter={StaticResource B2V}}" />
                            <Border Background="#CC17191C" CornerRadius="8" Padding="16,10"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding VsrBusy, Converter={StaticResource B2V}}">
                                <TextBlock Text="RTX VSR 处理中…" Foreground="White" FontSize="13" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 右栏 -->
                    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                  Background="{StaticResource B.Panel}">
                        <StackPanel Margin="16,4,16,24">

                            <!-- 文件 -->
                            <TextBlock Text="文件" Style="{StaticResource T.Section}" Margin="0,6,0,8" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="文件夹" Style="{StaticResource T.Label}" />
                                <TextBlock Grid.Column="1" Text="{Binding Current.Folder}" TextWrapping="Wrap"
                                           FontSize="12.5" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="文件名" Style="{StaticResource T.Label}" />
                                <TextBlock Grid.Column="1" Text="{Binding Current.FileName}" TextWrapping="Wrap"
                                           FontSize="12.5" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="尺寸" Style="{StaticResource T.Label}" />
                                <TextBlock Grid.Column="1" FontSize="12.5">
                                    <Run Text="{Binding Current.Resolution, Mode=OneWay}" />
                                    <Run Text="  ·  " Foreground="{StaticResource B.Text3}" />
                                    <Run Text="{Binding Current.SizeText, Mode=OneWay}" />
                                    <Run Text="  ·  " Foreground="{StaticResource B.Text3}" />
                                    <Run Text="{Binding Current.ExtText, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="日期" Style="{StaticResource T.Label}" />
                                <TextBlock Grid.Column="1" Text="{Binding Current.DateText}" FontSize="12.5" />
                            </Grid>

                            <Border Style="{StaticResource HLine}" Margin="0,10,0,10" />

                            <!-- 人物 -->
                            <StackPanel Visibility="{Binding Current.HasPeople, Converter={StaticResource B2V}}">
                                <TextBlock Text="人物" Style="{StaticResource T.Section}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Current.People}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource B.AccentSoft}" CornerRadius="12"
                                                    Padding="9,4" Margin="0,0,6,6">
                                                <TextBlock Text="{Binding Display}" FontSize="11.5"
                                                           Foreground="{StaticResource B.Accent}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Style="{StaticResource HLine}" Margin="0,6,0,10" />
                            </StackPanel>

                            <!-- 评分 + 备注 -->
                            <TextBlock Text="评分与备注" Style="{StaticResource T.Section}" Margin="0,0,0,8" />
                            <c:RatingBar x:Name="BigRating" DotSize="16" Gap="7" Height="18"
                                         Value="{Binding Current.Rating, Mode=OneWay}" Margin="0,2,0,10"
                                         RatingChanged="OnBigRatingChanged" />
                            <TextBox x:Name="NoteBox" Height="62" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" FontSize="12.5"
                                     Text="{Binding Current.Note, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                     TextChanged="OnNoteChanged" />

                            <Border Style="{StaticResource HLine}" Margin="0,14,0,10" />

                            <!-- 提示词 -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="正向提示词" Style="{StaticResource T.Section}" />
                                <Button Content="复制" Style="{StaticResource Btn.Ghost}" FontSize="11"
                                        Padding="6,2" HorizontalAlignment="Right" Click="OnCopyPrompt" />
                            </Grid>
                            <Border Background="White" BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                                    CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                                <TextBox Text="{Binding Current.Prompt, Mode=OneWay}" IsReadOnly="True"
                                         BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                         FontSize="11.5" MaxHeight="180" VerticalScrollBarVisibility="Auto"
                                         Foreground="{StaticResource B.Text2}" />
                            </Border>

                            <Grid Margin="0,0,0,6"
                                  Visibility="{Binding Current.HasNegative, Converter={StaticResource B2V}}">
                                <TextBlock Text="负面提示词" Style="{StaticResource T.Section}" />
                                <Button Content="复制" Style="{StaticResource Btn.Ghost}" FontSize="11"
                                        Padding="6,2" HorizontalAlignment="Right" Click="OnCopyNegative" />
                            </Grid>
                            <TextBlock Text="{Binding Current.NegHint}" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{StaticResource B.Danger}" Margin="0,0,0,6"
                                       Visibility="{Binding Current.NegHint, Converter={StaticResource NE2V}}" />
                            <Border Background="White" BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                                    CornerRadius="8" Padding="10,8" Margin="0,0,0,10"
                                    Visibility="{Binding Current.HasNegative, Converter={StaticResource B2V}}">
                                <TextBox Text="{Binding Current.Negative, Mode=OneWay}" IsReadOnly="True"
                                         BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                         FontSize="11.5" MaxHeight="110" VerticalScrollBarVisibility="Auto"
                                         Foreground="{StaticResource B.Text2}" />
                            </Border>

                            <Border Style="{StaticResource HLine}" Margin="0,4,0,10" />

                            <!-- 采样参数 -->
                            <TextBlock Text="采样参数" Style="{StaticResource T.Section}" Margin="0,0,0,8" />
                            <ItemsControl x:Name="ParamsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Key}" Style="{StaticResource T.Label}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource HLine}" Margin="0,10,0,10" />

                            <!-- 工作流 -->
                            <Expander Header="工作流" FontSize="12" Foreground="{StaticResource B.Text2}">
                                <Border Background="White" BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                                        CornerRadius="8" Padding="8" Margin="0,6,0,0">
                                    <TextBox Text="{Binding WorkflowText, Mode=OneWay}" IsReadOnly="True"
                                             BorderThickness="0" Background="Transparent" FontFamily="{StaticResource F.Mono}"
                                             FontSize="10.5" TextWrapping="NoWrap" MaxHeight="360"
                                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                                </Border>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 统计 -->
                <Grid x:Name="StatsPane" Visibility="Collapsed" Background="{StaticResource B.Window}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="20,14,20,10">
                        <Button Style="{StaticResource Btn.Ghost}" Click="OnCloseStats"
                                Padding="8,4">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" />
                                    <TextBlock Text="返回图库" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <TextBlock Text="统计" Style="{StaticResource T.Title}" Margin="14,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="StatsHost" Margin="20,0,20,24" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- 状态栏 -->
        <Grid Grid.Row="2" Background="{StaticResource B.Panel}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusLeft}" Style="{StaticResource T.Sub}" Margin="14,0,0,0"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding StatusRight}" Style="{StaticResource T.Sub}"
                       Margin="0,0,14,0" VerticalAlignment="Center" />
        </Grid>

        <!-- 忙碌遮罩 -->
        <Border Grid.Row="1" Background="#B3FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                <TextBlock Text="{Binding BusyText}" HorizontalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource B.Text2}" TextTrimming="CharacterEllipsis" />
                <ProgressBar Height="4" Margin="0,12,0,0" Value="{Binding BusyFraction}" Maximum="100"
                             Foreground="{StaticResource B.Accent}" Background="{StaticResource B.Border}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>









