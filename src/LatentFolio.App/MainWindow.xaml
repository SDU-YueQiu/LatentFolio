<Window x:Class="LatentFolio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:LatentFolio.App.Controls"
        xmlns:vm="clr-namespace:LatentFolio.App.ViewModels"
        xmlns:views="clr-namespace:LatentFolio.App.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LatentFolio" Height="1000" Width="1600" MinHeight="620" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource B.Window}"
        WindowStyle="None"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ── 图库格子 ───────────────────────────────────────────────
             图按原比例铺满自己的宽度（不裁剪）；选中态靠两层 1px 精度描边，
             不挤压内容：外层 2px 主色 + 内层 2px 白，正好落在 4px 内边距上。 -->
        <DataTemplate x:Key="TileTpl" DataType="{x:Type vm:ImageVm}">
            <Grid Background="Transparent" AutomationProperties.Name="{Binding FileName}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="21" />
                    <RowDefinition Height="17" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Border Background="{StaticResource B.Inset}" CornerRadius="10" ClipToBounds="True">
                        <Image c:ThumbLoader.SourceItem="{Binding}" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="Linear"
                               c:ThumbLoader.PixelWidth="{Binding DataContext.TileSize,
                                           RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Border>
                    <Border Background="{StaticResource B.Danger}" CornerRadius="999" Padding="8,2"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsMissing, Converter={StaticResource B2V}}">
                        <TextBlock Text="源文件丢失" Foreground="White" FontSize="11" />
                    </Border>
                </Grid>

                <TextBlock Grid.Row="1" Text="{Binding FileName}" FontSize="11.5"
                           Foreground="{StaticResource B.Text2}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="2,0" />

                <c:RatingBar Grid.Row="2" Value="{Binding Rating, Mode=TwoWay}" StarSize="8.5" Gap="3"
                             VerticalAlignment="Center" Margin="2,0,0,0" />
            </Grid>
        </DataTemplate>

        <Style x:Key="TileBox" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="12" Padding="4">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="ring" CornerRadius="12" BorderThickness="2"
                                    BorderBrush="Transparent" IsHitTestVisible="False" />
                            <Border x:Name="inner" Margin="2" CornerRadius="10" BorderThickness="2"
                                    BorderBrush="Transparent" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                                <Setter TargetName="inner" Property="BorderBrush" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── 左栏导航行：32 / 30 高，选中行 = 淡主色底 + 左 3px 主色杆 ── -->
        <Style x:Key="P.Shell.NavRow" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="bd" Background="Transparent" CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="bar" Width="3" Height="16" CornerRadius="2" Margin="1,0,0,0"
                                    Background="{StaticResource B.Accent}" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource B.AccentSoft}" />
                                <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="P.Shell.TreeRow" TargetType="ListBoxItem" BasedOn="{StaticResource P.Shell.NavRow}">
            <Setter Property="Height" Value="30" />
        </Style>

        <!-- 资源库行：折叠后整行隐藏 -->
        <Style x:Key="FolderRow" TargetType="ListBoxItem" BasedOn="{StaticResource P.Shell.TreeRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Visible}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── 人物墙一格 ── -->
        <DataTemplate x:Key="PersonTpl" DataType="{x:Type vm:PersonVm}">
            <Border x:Name="card" Width="200" Margin="6" Background="Transparent" CornerRadius="12"
                    BorderThickness="1" BorderBrush="Transparent" Padding="0"
                    Cursor="Hand" MouseLeftButtonDown="OnPersonClick" MouseRightButtonUp="OnPersonAvatar"
                    AutomationProperties.Name="{Binding Display}">
                <StackPanel>
                    <Border Height="198" Background="{StaticResource B.Inset}" CornerRadius="12"
                            ClipToBounds="True">
                        <Grid>
                            <Image c:ThumbLoader.SourceItem="{Binding}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   c:ThumbLoader.PixelWidth="204" />
                            <Border Background="{StaticResource B.GlassDark}" CornerRadius="999"
                                    Padding="6,2" Margin="8" HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding Count}" FontSize="10" Foreground="White" />
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Display}" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Margin="10,8,10,0" />
                    <Grid Height="16" Margin="10,2,10,10">
                        <TextBlock Text="{Binding TagSub}" FontSize="10.5" Foreground="{StaticResource B.Text3}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Visibility="{Binding TagSub, Converter={StaticResource NE2V}}" />
                    </Grid>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource B.BorderStrong}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ── 已生效的筛选条件钉（悬停加深一档） ── -->
        <Style x:Key="P.Shell.Chip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource B.AccentSoft}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource B.AccentSoft2}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 56px 图标轨上的方形按钮 -->
        <Style x:Key="P.Shell.RailBtn" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- ── 关闭键：悬停红底白字（只覆盖这一个按钮） ── -->
        <Style x:Key="P.Shell.CloseWin" TargetType="Button" BasedOn="{StaticResource Btn.Win}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Danger}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Danger}" />
                                <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── 忙碌进度条：4px 圆角细条，主色填充 / 凹槽底 ── -->
        <Style x:Key="P.Shell.BusyBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Background" Value="{StaticResource B.Inset}" />
            <Setter Property="Foreground" Value="{StaticResource B.Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="PART_Track" Background="Transparent" />
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2"
                                        Background="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 整窗一圈描边 -->
    <Border BorderBrush="{StaticResource B.Outline}" BorderThickness="1" Background="{StaticResource B.Window}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- ── 顶栏 ── -->
            <Grid Grid.Row="0" Background="{StaticResource B.Window}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource B.Logo}">
                        <TextBlock Text="L" Foreground="White" FontWeight="SemiBold" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="LatentFolio" Style="{StaticResource T.Title}" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                    <Border Style="{StaticResource VLine}" Height="14" Margin="12,0"
                            VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LibrarySummary}" Style="{StaticResource T.Sub}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                </StackPanel>

                <Border Grid.Column="1" MaxWidth="520" Height="32" CornerRadius="999"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource B.Inset}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="Background" Value="{StaticResource B.Window}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource B.Accent}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource F.Icon}" FontSize="13"
                                   Foreground="{StaticResource B.Text3}" Margin="12,0,8,0"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent" Padding="0,0,12,0"
                                 FontSize="12.5" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="搜索"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Btn.Icon}" HorizontalContentAlignment="Center"
                            Click="OnSettingsClick" ToolTip="设置" AutomationProperties.Name="设置">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource F.Icon}" FontSize="13"
                                   Foreground="{StaticResource B.Text2}" />
                    </Button>
                    <Button Style="{StaticResource Btn.Icon}" HorizontalContentAlignment="Center"
                            Click="OnScanClick" ToolTip="重新扫描图库" AutomationProperties.Name="重新扫描">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource F.Icon}" FontSize="13"
                                   Foreground="{StaticResource B.Text2}" />
                    </Button>
                    <Border Style="{StaticResource VLine}" Height="14" Margin="8,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource Btn.Win}" HorizontalContentAlignment="Center"
                            Click="OnMinClick" AutomationProperties.Name="最小化">
                        <TextBlock Text="&#xE921;" FontFamily="{StaticResource F.Icon}" FontSize="12"
                                   Foreground="{StaticResource B.Text2}" />
                    </Button>
                    <Button x:Name="MaxBtn" Style="{StaticResource Btn.Win}" HorizontalContentAlignment="Center"
                            Click="OnMaxClick" AutomationProperties.Name="最大化">
                        <TextBlock Text="&#xE922;" FontFamily="{StaticResource F.Icon}" FontSize="12"
                                   Foreground="{StaticResource B.Text2}" />
                    </Button>
                    <Button Style="{StaticResource P.Shell.CloseWin}" Click="OnCloseClick"
                            AutomationProperties.Name="关闭">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource F.Icon}" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver,
                                                    RelativeSource={RelativeSource AncestorType=Button}}"
                                                     Value="True">
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </StackPanel>

                <Border Grid.ColumnSpan="3" Style="{StaticResource HLine}" VerticalAlignment="Bottom" />
            </Grid>

            <!-- ── 主体 ── -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding LeftWidth, Converter={StaticResource D2G}}"
                                      MinWidth="56" MaxWidth="460" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左栏（完整态） -->
                <Grid x:Name="LeftPane" Grid.Column="0" Background="{StaticResource B.Panel}"
                      Visibility="{Binding LeftCollapsed, Converter={StaticResource InvB2V}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{Binding LeftColumnsHeight, Converter={StaticResource D2G}}"
                                       MinHeight="88" />
                        <RowDefinition Height="7" />
                        <RowDefinition Height="{Binding LeftPeopleRowHeight, Converter={StaticResource D2G}}"
                                       MinHeight="64" />
                        <RowDefinition Height="7" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 总览 / 统计 / 标签 -->
                    <Grid Grid.Row="0" Margin="8,10,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <Button Style="{StaticResource Btn.Ghost}" HorizontalContentAlignment="Stretch"
                                    Height="32" Padding="8,0" Click="OnOverviewClick"
                                    AutomationProperties.Name="总览">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE80F;" FontFamily="{StaticResource F.Icon}"
                                               FontSize="13" Foreground="{StaticResource B.Text2}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="总览 · 全部图片" Margin="8,0,0,0"
                                               VerticalAlignment="Center" FontSize="12.5" />
                                    <TextBlock Grid.Column="2" Text="{Binding TotalCount, StringFormat={}{0:N0}}"
                                               Style="{StaticResource T.Sub}" VerticalAlignment="Center"
                                               Margin="8,0,0,0" />
                                </Grid>
                            </Button>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="统计" FontSize="11.5" Height="28"
                                        Style="{StaticResource Btn.Outline}" Click="OnStatsClick"
                                        AutomationProperties.Name="统计" />
                                <Button Grid.Column="2" Content="标签" FontSize="11.5" Height="28"
                                        Style="{StaticResource Btn.Outline}" Click="OnTagsClick"
                                        AutomationProperties.Name="标签体系" />
                            </Grid>
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource HLine}" Margin="0,10,0,0" />
                    </Grid>

                    <!-- 我的栏 -->
                    <Grid Grid.Row="1" Margin="14,10,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="我的栏" Style="{StaticResource T.Section}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="+ 新建" Style="{StaticResource Btn.Ghost}"
                                FontSize="11.5" Padding="6,2" Foreground="{StaticResource B.Text3}"
                                Click="OnNewColumnClick" AutomationProperties.Name="新建栏" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="6,0,6,0">
                        <ListBox x:Name="ColList" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemsSource="{Binding Columns}"
                                 ItemContainerStyle="{StaticResource P.Shell.NavRow}"
                                 AllowDrop="True"
                                 PreviewMouseLeftButtonDown="OnColMouseDown"
                                 PreviewMouseRightButtonUp="OnColRightUp"
                                 PreviewMouseMove="OnColMouseMove"
                                 DragOver="OnColDragOver"
                                 DragLeave="OnColDragLeave"
                                 Drop="OnColDrop">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ColumnVm}">
                                    <Grid AutomationProperties.Name="{Binding Name}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="1,0,8,0"
                                                 Fill="{Binding Color, Converter={StaticResource HexB}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" FontSize="12.5" />
                                        <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource T.Sub}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border x:Name="ColDragLine" Height="2" Background="{StaticResource B.Accent}"
                                VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>

                    <Border Grid.Row="3" Height="7" Background="Transparent" Cursor="SizeNS" Tag="cols"
                            MouseLeftButtonDown="OnLeftRowDragStart" MouseMove="OnLeftRowDragMove"
                            MouseLeftButtonUp="OnLeftRowDragEnd" AutomationProperties.Name="调整我的栏高度">
                        <Border Style="{StaticResource HLine}" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Border>

                    <!-- 人物：10 个一直铺满栏宽，卡片随宽度变正方形 -->
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="14,10,14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="人物" Style="{StaticResource T.Section}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource Btn.Ghost}" Padding="6,2"
                                    Click="OnPeopleClick" AutomationProperties.Name="全部人物">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="全部" Style="{StaticResource T.Sub}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource F.Icon}" FontSize="10"
                                               Foreground="{StaticResource B.Text3}" Margin="4,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding PeoplePreview}" Margin="12,0,8,4"
                                          Height="{Binding PeopleBlockHeight}" VerticalAlignment="Top">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding PeopleCols}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="cell" Margin="2" Background="{StaticResource B.Inset}"
                                                CornerRadius="8" BorderThickness="1.5" BorderBrush="Transparent"
                                                ClipToBounds="True" MouseLeftButtonDown="OnPersonClick"
                                                Cursor="Hand" AutomationProperties.Name="{Binding Display}">
                                            <Border.Height>
                                                <Binding Path="DataContext.PeopleCardSide"
                                                         RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                            </Border.Height>
                                            <Grid>
                                                <Image c:ThumbLoader.SourceItem="{Binding}" Stretch="UniformToFill" />
                                                <Border Background="{StaticResource B.GlassDark}" CornerRadius="999"
                                                        Padding="4,1" Margin="4" HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom">
                                                    <TextBlock Text="{Binding Count}" FontSize="10"
                                                               Foreground="White" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="cell" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="cell" Property="BorderBrush"
                                                        Value="{StaticResource B.Accent}" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Border Grid.Row="5" Height="7" Background="Transparent" Cursor="SizeNS" Tag="people"
                            MouseLeftButtonDown="OnLeftRowDragStart" MouseMove="OnLeftRowDragMove"
                            MouseLeftButtonUp="OnLeftRowDragEnd" AutomationProperties.Name="调整人物高度">
                        <Border Style="{StaticResource HLine}" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Border>

                    <!-- 资源库 -->
                    <Grid Grid.Row="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="14,10,14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="资源库" Style="{StaticResource T.Section}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="{Binding FolderSortLabel}"
                                    Style="{StaticResource Btn.Ghost}" FontSize="11" Padding="6,2"
                                    Foreground="{StaticResource B.Text3}"
                                    VerticalAlignment="Center" Click="OnFolderSortMenu"
                                    AutomationProperties.Name="资源库排序" Margin="0,0,2,0" />
                            <Button Grid.Column="2" Style="{StaticResource Btn.IconSm}"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center" Click="OnLibraryMenu"
                                    AutomationProperties.Name="图库目录菜单" ToolTip="{Binding LibraryRoot}">
                                <TextBlock Text="&#xE712;" FontFamily="{StaticResource F.Icon}" FontSize="13"
                                           Foreground="{StaticResource B.Text2}" />
                            </Button>
                        </Grid>
                        <ListBox x:Name="FolderList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                 Margin="6,0,6,4"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemsSource="{Binding Folders}" SelectionChanged="OnFolderSelected"
                                 ItemContainerStyle="{StaticResource FolderRow}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FolderVm}">
                                    <Grid AutomationProperties.Name="{Binding Display}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="14" Margin="{Binding DepthText}" Background="Transparent">
                                            <!-- 缩进位始终占宽，叶子节点也能和父级对齐；只有父级那格可点 -->
                                            <Border Background="Transparent" MouseLeftButtonDown="OnFolderChevron"
                                                    Visibility="{Binding HasChildren, Converter={StaticResource B2V}}">
                                                <TextBlock FontFamily="{StaticResource F.Icon}" FontSize="10"
                                                           Foreground="{StaticResource B.Text3}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xE70D;" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Expanded}" Value="False">
                                                                    <Setter Property="Text" Value="&#xE76C;" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Display}" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource T.Sub}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- 常驻底部：已删除 -->
                    <Button Grid.Row="7" Style="{StaticResource Btn.Ghost}" HorizontalContentAlignment="Stretch"
                            Height="32" Margin="8,0,8,8" Padding="8,0" Click="OnDeletedClick"
                            AutomationProperties.Name="已删除">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource F.Icon}" FontSize="12"
                                       Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="已删除" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource T.Label}" />
                            <Border Grid.Column="2" Style="{StaticResource Pill.Danger}" Margin="8,0,0,0">
                                <TextBlock Text="{Binding DeletedCount, StringFormat={}{0:N0}}" FontSize="11.5"
                                           Foreground="{StaticResource B.Danger}" />
                            </Border>
                        </Grid>
                    </Button>
                </Grid>

                <!-- 左栏（56px 图标轨） -->
                <Grid Grid.Column="0" Background="{StaticResource B.Panel}"
                      Visibility="{Binding LeftCollapsed, Converter={StaticResource B2V}}">
                    <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center">
                        <Button Style="{StaticResource P.Shell.RailBtn}" Click="OnOverviewClick" ToolTip="总览"
                                AutomationProperties.Name="总览">
                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource F.Icon}" FontSize="15"
                                       Foreground="{StaticResource B.Text2}" />
                        </Button>
                        <Button Style="{StaticResource P.Shell.RailBtn}" Click="OnNewColumnClick" ToolTip="新建栏"
                                AutomationProperties.Name="新建栏">
                            <TextBlock Text="+" FontSize="15" Foreground="{StaticResource B.Text2}" />
                        </Button>
                        <Button Style="{StaticResource P.Shell.RailBtn}" Click="OnPeopleClick" ToolTip="人物"
                                AutomationProperties.Name="人物">
                            <TextBlock Text="&#xE77B;" FontFamily="{StaticResource F.Icon}" FontSize="15"
                                       Foreground="{StaticResource B.Text2}" />
                        </Button>
                        <Button Style="{StaticResource P.Shell.RailBtn}" Click="OnLibraryMenu" ToolTip="资源库"
                                AutomationProperties.Name="资源库">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource F.Icon}" FontSize="15"
                                       Foreground="{StaticResource B.Text2}" />
                        </Button>
                        <Button Style="{StaticResource P.Shell.RailBtn}" Click="OnDeletedClick" ToolTip="已删除"
                                AutomationProperties.Name="已删除">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource F.Icon}" FontSize="15"
                                       Foreground="{StaticResource B.Text2}" />
                        </Button>
                        <Button Style="{StaticResource P.Shell.RailBtn}" Click="OnTagsClick" ToolTip="标签体系"
                                AutomationProperties.Name="标签体系">
                            <TextBlock Text="&#xE8EC;" FontFamily="{StaticResource F.Icon}" FontSize="15"
                                       Foreground="{StaticResource B.Text2}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 左栏分隔条 + 折叠手柄 -->
                <Grid Grid.Column="1" Background="Transparent">
                    <Border Style="{StaticResource VLine}" HorizontalAlignment="Center" />
                    <GridSplitter x:Name="LeftSplitter" Width="5" HorizontalAlignment="Stretch"
                                  Background="Transparent" ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Columns" Cursor="SizeWE"
                                  DragDelta="OnLeftSplitterDrag"
                                  Visibility="{Binding LeftCollapsed, Converter={StaticResource InvB2V}}" />
                </Grid>

                <!-- ── 内容区 ── -->
                <Grid Grid.Column="2">

                    <!-- 图库 -->
                    <Grid x:Name="LibraryPane">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="20,16,20,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource T.Page}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding HitCount, StringFormat={}{0:N0} 张}" Style="{StaticResource T.Sub}"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                                <Button Content="编辑条件" Style="{StaticResource Btn.Ghost}" FontSize="12"
                                        Margin="8,0,0,0" Padding="8,2" Click="OnEditColumnClick"
                                        Visibility="{Binding IsColumnView, Converter={StaticResource B2V}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 简易筛选：星级 / 角色 / 模型，三个都从当前结果里出 -->
                                <Button x:Name="StarFilterBtn" Content="星级" Style="{StaticResource Btn.Pill}"
                                        Height="30" Click="OnStarFilter"
                                        AutomationProperties.Name="按星级筛选" />
                                <Button x:Name="CharFilterBtn" Content="角色" Style="{StaticResource Btn.Pill}"
                                        Height="30" Margin="6,0,0,0"
                                        Click="OnCharFilter" AutomationProperties.Name="按角色筛选" />
                                <Button x:Name="ModelFilterBtn" Content="模型" Style="{StaticResource Btn.Pill}"
                                        Height="30" Margin="6,0,0,0"
                                        Click="OnModelFilter" AutomationProperties.Name="按模型筛选" />
                                <Button Style="{StaticResource Btn.Icon}" HorizontalContentAlignment="Center"
                                        Margin="4,0,0,0" Click="OnAdvancedFilter"
                                        ToolTip="高级筛选（条件树）" AutomationProperties.Name="高级筛选">
                                    <TextBlock Text="&#xE712;" FontFamily="{StaticResource F.Icon}" FontSize="13"
                                               Foreground="{StaticResource B.Text2}" />
                                </Button>
                                <Button x:Name="FilterClearBtn" Style="{StaticResource Btn.IconSm}"
                                        HorizontalContentAlignment="Center"
                                        Margin="2,0,0,0" Click="OnFilterClear" ToolTip="清除筛选"
                                        AutomationProperties.Name="清除筛选"
                                        Visibility="{Binding HasTempFilter, Converter={StaticResource B2V}}">
                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource F.Icon}" FontSize="12"
                                               Foreground="{StaticResource B.Text3}" />
                                </Button>

                                <TextBlock Text="排序" Style="{StaticResource T.Label}" VerticalAlignment="Center"
                                           Margin="14,0,6,0" />
                                <ComboBox x:Name="SortBox" Width="112" SelectedIndex="0"
                                          SelectionChanged="OnSortKeyChanged">
                                    <ComboBoxItem Content="添加时间" />
                                    <ComboBoxItem Content="评分" />
                                    <ComboBoxItem Content="文件名" />
                                    <ComboBoxItem Content="分辨率" />
                                    <ComboBoxItem Content="文件大小" />
                                </ComboBox>
                                <Button x:Name="SortDirBtn" Style="{StaticResource Btn.Icon}"
                                        HorizontalContentAlignment="Center"
                                        Margin="6,0,0,0" Click="OnToggleSortDir" ToolTip="正序 / 倒序"
                                        AutomationProperties.Name="排序方向">
                                    <TextBlock Text="{Binding SortDirGlyph}" FontSize="12"
                                               Foreground="{StaticResource B.Text2}" />
                                </Button>

                                <Border Style="{StaticResource VLine}" Height="18" Margin="14,0" VerticalAlignment="Center" />

                                <!-- 缩略图 4 档 -->
                                <Border Style="{StaticResource Seg.Track}" Padding="2" VerticalAlignment="Center">
                                    <StackPanel x:Name="SizeBar" Orientation="Horizontal" VerticalAlignment="Center"
                                                AutomationProperties.Name="缩略图尺寸">
                                        <Button Style="{StaticResource Btn.Seg}" Click="OnSizeStep" Tag="0" Width="26"
                                                Height="26" Padding="0" ToolTip="小">
                                            <Border Width="5" Height="5" CornerRadius="1"
                                                    Background="{StaticResource B.Text2}" />
                                        </Button>
                                        <Button Style="{StaticResource Btn.Seg}" Click="OnSizeStep" Tag="1" Width="26"
                                                Height="26" Padding="0" ToolTip="中">
                                            <Border Width="8" Height="8" CornerRadius="1"
                                                    Background="{StaticResource B.Text2}" />
                                        </Button>
                                        <Button Style="{StaticResource Btn.Seg}" Click="OnSizeStep" Tag="2" Width="26"
                                                Height="26" Padding="0" ToolTip="大">
                                            <Border Width="11" Height="11" CornerRadius="2"
                                                    Background="{StaticResource B.Text2}" />
                                        </Button>
                                        <Button Style="{StaticResource Btn.Seg}" Click="OnSizeStep" Tag="3" Width="26"
                                                Height="26" Padding="0" ToolTip="特大">
                                            <Border Width="14" Height="14" CornerRadius="2"
                                                    Background="{StaticResource B.Text2}" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <ItemsControl Grid.Row="1" Grid.ColumnSpan="3" ItemsSource="{Binding Chips}"
                                          Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource P.Shell.Chip}">
                                            <TextBlock Text="{Binding}" FontSize="11.5"
                                                       Foreground="{StaticResource B.Accent}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{Binding DetailWidth, Converter={StaticResource D2G}}" />
                            </Grid.ColumnDefinitions>

                            <ListBox x:Name="GridList" Background="Transparent" BorderThickness="0"
                                     ItemsSource="{Binding Items}" SelectionMode="Extended"
                                     ItemContainerStyle="{StaticResource TileBox}"
                                     ItemTemplate="{StaticResource TileTpl}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Standard"
                                     SelectionChanged="OnGridSelectionChanged"
                                     MouseDoubleClick="OnGridDoubleClick"
                                     KeyDown="OnGridKeyDown"
                                     PreviewMouseRightButtonDown="OnGridPreviewRightDown"
                                     PreviewMouseRightButtonUp="OnGridRightUp">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <c:JustifiedGridPanel TargetHeight="{Binding TileSize}"
                                                              Spacing="12" CaptionHeight="38"
                                                              Pad="20,6,20,24" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>

                            <Border x:Name="LibraryDetailHost" Grid.Column="1" Background="{StaticResource B.Panel}"
                                    BorderBrush="{StaticResource B.Border}" BorderThickness="1,0,0,0"
                                    Visibility="{Binding IsPanelVisible, Converter={StaticResource B2V}}">
                                <views:DetailPanel />
                            </Border>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding IsEmpty, Converter={StaticResource B2V}}">
                                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource T.Empty}"
                                           HorizontalAlignment="Center" />
                                <Button Content="选择图库目录…" Style="{StaticResource Btn.Outline}" Height="32"
                                        Padding="14,0" Margin="0,14,0,0" HorizontalAlignment="Center"
                                        Click="OnSettingsClick"
                                        Visibility="{Binding IsLibraryEmpty, Converter={StaticResource B2V}}" />
                            </StackPanel>
                        </Grid>
                    </Grid>


                    <!-- 人物墙（中间显示，不弹窗） -->
                    <Grid x:Name="PeoplePane" Visibility="{Binding ShowPeoplePane, Converter={StaticResource B2V}}"
                          Background="{StaticResource B.Window}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="20,16,20,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource Btn.Ghost}" Click="OnClosePeople"
                                    AutomationProperties.Name="返回图库" Padding="8,4">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72B;" FontFamily="{StaticResource F.Icon}" FontSize="13"
                                                   Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" />
                                        <TextBlock Text="返回图库" FontSize="12.5" Foreground="{StaticResource B.Text2}"
                                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                            <TextBlock Grid.Column="1" Text="人物" Style="{StaticResource T.Page}"
                                       Margin="14,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding PeopleCountText}" Style="{StaticResource T.Sub}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBox Grid.Column="3" x:Name="PeopleFilterBox" Width="220" Height="30" Margin="16,0,0,0"
                                     VerticalContentAlignment="Center" FontSize="12.5" Padding="10,0"
                                     Background="{StaticResource B.Inset}" BorderBrush="Transparent" BorderThickness="1"
                                     AutomationProperties.Name="搜索人物"
                                     Text="{Binding PeopleQuery, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="只看有中文名" FontSize="12" VerticalAlignment="Center"
                                          IsChecked="{Binding PeopleOnlyZh}" />
                                <ComboBox Width="132" Margin="12,0,0,0" SelectedIndex="0" SelectionChanged="OnPeopleSort">
                                    <ComboBoxItem Content="张数 · 多在前" />
                                    <ComboBoxItem Content="中文名 · A-Z" />
                                    <ComboBoxItem Content="tag · A-Z" />
                                </ComboBox>
                                <Button Content="候选池" Style="{StaticResource Btn.Outline}" Height="30"
                                        Padding="12,0" Margin="10,0,0,0" Click="OnCandidates"
                                        AutomationProperties.Name="候选池" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PeopleView}" ItemTemplate="{StaticResource PersonTpl}"
                                          Margin="14,4,14,24">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- 查看器 -->
                    <Grid x:Name="ViewerPane" Visibility="{Binding ViewerOpen, Converter={StaticResource B2V}}"
                          Background="{StaticResource B.Window}">
                        <Grid.Resources>
                            <!-- 舞台：深灰纵向渐变，画面上只有图片是亮的 -->
                            <LinearGradientBrush x:Key="P.Viewer.Stage" StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF101217" Offset="0" />
                                <GradientStop Color="#FF191D24" Offset="1" />
                            </LinearGradientBrush>
                            <!-- 舞台与工具条之间的 1px 深色分隔 -->
                            <SolidColorBrush x:Key="P.Viewer.Rule" Color="#FF0B0D11" />
                            <!-- 工具条里的小图标 / 文字 -->
                            <Style x:Key="P.Viewer.Glyph" TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource F.Icon}" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style x:Key="P.Viewer.Caption" TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource F.UI}" />
                                <Setter Property="FontSize" Value="12.5" />
                                <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <!-- 浮在图片上的胶囊：加载中 / VSR 处理中 -->
                            <Style x:Key="P.Viewer.GlassPill" TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource B.GlassDark}" />
                                <Setter Property="CornerRadius" Value="999" />
                                <Setter Property="Padding" Value="16,9" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </Grid.Resources>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{Binding DetailWidth, Converter={StaticResource D2G}}" />
                        </Grid.ColumnDefinitions>

                        <!-- 工具条：46 高，跨两列；不铺底色块，只用底边 HLine 收口 -->
                        <Grid Grid.Row="0" Grid.ColumnSpan="2" Height="46">
                            <Grid Margin="18,0,14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Style="{StaticResource Btn.Ghost}" Height="30" Padding="8,0"
                                        VerticalAlignment="Center" Click="OnCloseViewer"
                                        AutomationProperties.Name="返回">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72B;" Style="{StaticResource P.Viewer.Glyph}" />
                                        <TextBlock Text="返回" Style="{StaticResource P.Viewer.Caption}"
                                                   Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Grid.Column="1" Text="{Binding Current.FileName}"
                                           Style="{StaticResource T.Title}" Margin="14,0,0,0"
                                           VerticalAlignment="Center" MaxWidth="400"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Current.Resolution}"
                                           Style="{StaticResource T.Sub}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />

                                <Border Grid.Column="3" Background="{StaticResource B.AccentSoft}"
                                        CornerRadius="999" Padding="9,3" Margin="10,0,0,0"
                                        VerticalAlignment="Center" ToolTip="{Binding VsrBadge}"
                                        Visibility="{Binding VsrBadge, Converter={StaticResource NE2V}}">
                                    <TextBlock Text="{Binding VsrBadge}" FontSize="11.5"
                                               Foreground="{StaticResource B.Accent}"
                                               MaxWidth="240" TextTrimming="CharacterEllipsis" />
                                </Border>

                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="16,0,0,0">
                                    <Button Content="RTX VSR" Style="{StaticResource Btn.Outline}" Height="30"
                                            Padding="12,0" FontSize="12" Click="OnVsrClick"
                                            AutomationProperties.Name="RTX VSR 按钮" />
                                    <Button Style="{StaticResource Btn.Ghost}" Height="30" Padding="10,0"
                                            Margin="6,0,0,0" Click="OnToggleOriginal" ToolTip="显示原图"
                                            AutomationProperties.Name="显示原图">
                                        <TextBlock Text="原图" Style="{StaticResource P.Viewer.Caption}" />
                                    </Button>
                                    <Button Style="{StaticResource Btn.Icon}" Margin="6,0,0,0" Click="OnPrev"
                                            ToolTip="上一张" AutomationProperties.Name="上一张">
                                        <TextBlock Text="&#xE76B;" Style="{StaticResource P.Viewer.Glyph}" />
                                    </Button>
                                    <Button Style="{StaticResource Btn.Icon}" Margin="4,0,0,0" Click="OnNext"
                                            ToolTip="下一张" AutomationProperties.Name="下一张">
                                        <TextBlock Text="&#xE76C;" Style="{StaticResource P.Viewer.Glyph}" />
                                    </Button>
                                    <Button Style="{StaticResource Btn.Ghost}" Height="30" Padding="8,0"
                                            Margin="6,0,0,0" Click="OnReveal">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B7;" Style="{StaticResource P.Viewer.Glyph}" />
                                            <TextBlock Text="在文件夹中显示"
                                                       Style="{StaticResource P.Viewer.Caption}" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource HLine}" VerticalAlignment="Bottom" />
                        </Grid>

                        <!-- 舞台：深灰渐变，大图居中留白 24 -->
                        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource P.Viewer.Stage}"
                                BorderBrush="{StaticResource P.Viewer.Rule}" BorderThickness="0,1,0,0"
                                ClipToBounds="True">
                            <Grid>
                                <c:ZoomBox x:Name="BigZoom" Margin="0">
                                    <Image x:Name="BigImage" Source="{Binding ViewerImage.Source}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" Margin="24"
                                           PreviewMouseRightButtonUp="OnViewerRightUp" />
                                </c:ZoomBox>
                                <Border Style="{StaticResource P.Viewer.GlassPill}"
                                        Visibility="{Binding ViewerLoading, Converter={StaticResource B2V}}">
                                    <TextBlock Text="加载中…" Foreground="White" FontSize="12.5" />
                                </Border>
                                <Border Style="{StaticResource P.Viewer.GlassPill}"
                                        Visibility="{Binding VsrBusy, Converter={StaticResource B2V}}">
                                    <TextBlock Text="RTX VSR 处理中…" Foreground="White" FontSize="12.5" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 折叠把手用外层那套叠层，这里不再放一份 -->

                        <!-- 胶片条拖拽条：平时一条 1px 线，悬停变主色 -->
                        <Border Grid.Row="2" Grid.Column="0" Height="7" Background="{StaticResource B.Window}"
                                Cursor="SizeNS" MouseLeftButtonDown="OnFilmDragStart"
                                MouseMove="OnFilmDragMove" MouseLeftButtonUp="OnFilmDragEnd"
                                AutomationProperties.Name="胶片条高度">
                            <Border Height="1" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource B.Border}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
                                                         Value="True">
                                                <Setter Property="Background" Value="{StaticResource B.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Border>
                        <!-- 胶片条：白底 + 顶边 HLine，高度可拖 -->
                        <Border Grid.Row="3" Grid.Column="0" Height="{Binding FilmHeight}"
                                Background="{StaticResource B.Window}" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource HLine}" />
                                <ScrollViewer x:Name="FilmScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled" Padding="12,8"
                                              PreviewMouseWheel="OnFilmWheel">
                                    <ItemsControl x:Name="FilmList" ItemsSource="{Binding Filmstrip}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ImageVm}">
                                                <Border x:Name="fs" Height="{Binding DataContext.FilmImageHeight,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CornerRadius="6" ClipToBounds="True" Margin="0,0,4,0"
                                                        Background="{StaticResource B.Tile}" BorderThickness="2"
                                                        BorderBrush="Transparent" Cursor="Hand" Opacity="0.72"
                                                        MouseLeftButtonDown="OnFilmClick"
                                                        AutomationProperties.Name="{Binding FileName}">
                                                    <Border.Width>
                                                        <MultiBinding Converter="{StaticResource FilmW}">
                                                            <Binding Path="Width" />
                                                            <Binding Path="Height" />
                                                            <Binding Path="DataContext.FilmImageHeight"
                                                                     RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        </MultiBinding>
                                                    </Border.Width>
                                                    <Image c:ThumbLoader.SourceItem="{Binding}" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           c:ThumbLoader.PixelWidth="{Binding DataContext.FilmImageHeight,
                                                                       RelativeSource={RelativeSource AncestorType=Window}}" />
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="fs" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="fs" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter TargetName="fs" Property="BorderBrush"
                                                                Value="{StaticResource B.Accent}" />
                                                        <Setter TargetName="fs" Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" Background="{StaticResource B.Panel}"
                                BorderBrush="{StaticResource B.Border}" BorderThickness="1,0,0,0"
                                Visibility="{Binding IsPanelVisible, Converter={StaticResource B2V}}">
                            <views:DetailPanel />
                        </Border>
                    </Grid>

                    <!-- 统计 -->
                    <Grid x:Name="StatsPane" Visibility="Collapsed" Background="{StaticResource B.Window}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="20,16,20,10">
                            <Button Style="{StaticResource Btn.Ghost}" Click="OnCloseStats"
                                    AutomationProperties.Name="返回图库" Padding="8,4">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72B;" FontFamily="{StaticResource F.Icon}" FontSize="13"
                                                   Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" />
                                        <TextBlock Text="返回图库" FontSize="12.5" Foreground="{StaticResource B.Text2}"
                                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                            <TextBlock Text="统计" Style="{StaticResource T.Page}" Margin="14,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="StatsHost" Margin="20,0,20,24" />
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- 折叠把手叠层：跨所有列、盖在最上面，两个把手同一套尺寸、同一个垂直中线 -->
                <Grid Grid.Column="0" Grid.ColumnSpan="3" Panel.ZIndex="80">
                    <Button x:Name="LeftTab" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="{Binding LeftHandleMargin}"
                            Click="OnToggleLeftRail" AutomationProperties.Name="收起左栏">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Btn.Tab}">
                                <Setter Property="FontFamily" Value="{StaticResource F.Icon}" />
                                <Setter Property="Content" Value="&#xE76B;" />
                                <Setter Property="ToolTip" Value="收起左栏" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LeftCollapsed}" Value="True">
                                        <Setter Property="Content" Value="&#xE76C;" />
                                        <Setter Property="ToolTip" Value="展开左栏" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="DetailTab" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="{Binding DetailHandleMargin}"
                            Click="OnTogglePanel" AutomationProperties.Name="收起详情栏">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Btn.Tab}">
                                <Setter Property="FontFamily" Value="{StaticResource F.Icon}" />
                                <Setter Property="Content" Value="&#xE76B;" />
                                <Setter Property="ToolTip" Value="收起详情栏" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPanelVisible}" Value="False">
                                        <Setter Property="Content" Value="&#xE76C;" />
                                        <Setter Property="ToolTip" Value="展开详情栏" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>

            <!-- ── 状态栏 ── -->
            <Grid Grid.Row="2" Background="{StaticResource B.Panel}">
                <Border Style="{StaticResource HLine}" VerticalAlignment="Top" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusLeft}" Style="{StaticResource T.Sub}" Margin="14,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusRight}" Style="{StaticResource T.Sub}"
                               Margin="0,0,14,0" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <!-- 忙碌遮罩 -->
            <Border Grid.Row="1" Background="#E6FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                    <TextBlock Text="{Binding BusyText}" HorizontalAlignment="Center" FontSize="13"
                               Foreground="{StaticResource B.Text2}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Style="{StaticResource P.Shell.BusyBar}" Height="4" Margin="0,12,0,0"
                                 Value="{Binding BusyFraction}" Maximum="100"
                                 Foreground="{StaticResource B.Accent}" Background="{StaticResource B.Inset}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
